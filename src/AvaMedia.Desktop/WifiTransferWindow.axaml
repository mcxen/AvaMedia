<Window xmlns:ac="using:AvaMedia.Controls" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:AvaMedia.Desktop" x:Class="AvaMedia.Desktop.WifiTransferWindow"
        Title="WiFi 传文件" Width="1100" Height="800" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="{DynamicResource UiPagePadding}" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Spacing="5" Margin="0,0,0,14">
      <TextBlock Text="手机和电脑需连接同一局域网" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,14">
      <TextBlock Text="网络地址" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox Classes="ac" x:Name="NetworkInput" Grid.Column="1" HorizontalAlignment="Stretch" i18n:Localization.IsUserText="True"/>
      <Button Classes="ac" x:Name="RefreshNetworkButton" Grid.Column="2" Content="刷新网络" Click="RefreshNetworkClick" Margin="8,0,0,0"/>
      <Button Classes="ac" x:Name="StartReceiveButton" Grid.Column="3" Content="开启传输" Click="StartReceiveClick" Margin="8,0,0,0"/>
      <Button Classes="ac" x:Name="StopReceiveButton" Grid.Column="4" Content="关闭传输" Click="StopReceiveClick" Margin="8,0,0,0" IsEnabled="False"/>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <CheckBox Classes="ac" x:Name="AutoCloseInput" Content="空闲 5 分钟自动关闭" IsChecked="True"
                IsCheckedChanged="AutoCloseChanged" VerticalAlignment="Center"/>
      <TextBlock x:Name="ConnectionStatus" i18n:StableLayout.StatusLines="2" Grid.Column="1" Text="传输已关闭"
                 Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="240,16,*">
      <Border Classes="ac-card">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="传输用户" FontSize="{DynamicResource UiFontTitle}" FontWeight="SemiBold"/>
          <TextBlock x:Name="UserSummary" Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" FontSize="{DynamicResource UiFontCaption}"/>
          <ListBox x:Name="UsersList" Grid.Row="2" SelectionChanged="UserSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="5" Margin="4,10">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                  <TextBlock Text="{Binding Status}" FontSize="{DynamicResource UiFontCaption}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Address}" FontSize="{DynamicResource UiFontCaption}" i18n:Localization.IsUserText="True"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <TextBlock x:Name="MediaHeading" Text="全部媒体与文件" FontSize="{DynamicResource UiFontTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Expander x:Name="ConnectionPanel" Grid.Row="1" Header="扫码连接" HorizontalAlignment="Stretch" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,16,*" Margin="10">
            <Border Background="White" Padding="8" VerticalAlignment="Top">
              <Image x:Name="QrImage" Width="176" Height="176" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
            <StackPanel Grid.Column="2" Spacing="{DynamicResource AcRowGap}">
              <TextBox Classes="ac" x:Name="AddressText" IsReadOnly="True" TextWrapping="Wrap" i18n:Localization.IsUserText="True"/>
              <Button Classes="ac" x:Name="CopyAddressButton" Content="复制扫码地址" Click="CopyAddressClick" IsEnabled="False"/>
              <TextBlock Text="仅限可信局域网；关闭传输后地址失效。" TextWrapping="Wrap" FontSize="{DynamicResource UiFontCaption}"/>
            </StackPanel>
          </Grid>
        </Expander>
      <TabControl Grid.Row="2">
        <TabItem Header="接收到电脑">
          <Grid RowDefinitions="Auto,*,Auto" Margin="10">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock x:Name="ReceiveSummary" Text="尚未接收文件" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <Button Classes="ac" Grid.Column="1" Content="打开接收目录" Click="OpenReceiveFolderClick" Margin="10,0,0,0"/>
            </Grid>
            <Grid Grid.Row="1">
            <ListBox Classes="ac surface" x:Name="ReceivedList" SelectionMode="Multiple" SelectionChanged="SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding MediaType}" FontSize="{DynamicResource UiFontCaption}"/>
                      <TextBlock Text="{Binding UserName}" FontSize="{DynamicResource UiFontCaption}" i18n:Localization.IsUserText="True"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{DynamicResource UiFontCaption}"/>
                    <ProgressBar Classes="ac" Value="{Binding Progress}" Maximum="100" IsVisible="{Binding Receiving}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <ac:EmptyState x:Name="EmptyReceivedList" Text="尚未接收文件" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource AcRowGap}" Margin="0,12,0,10">
              <Button Classes="ac" x:Name="SelectReceivedButton" Content="全选已接收" Click="SelectReceivedClick" IsEnabled="False"/>
              <Button Classes="ac" x:Name="ImportReceivedButton" Content="导入转换" Click="ImportReceivedClick" IsEnabled="False"/>
              <Button Classes="ac" x:Name="CompressReceivedButton" Content="高画质视频压缩" Click="CompressReceivedClick" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="发送到手机">
          <Grid RowDefinitions="Auto,*,Auto" Margin="10">
            <TextBlock Text="所有连接用户均可下载" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid Grid.Row="1">
            <ListBox Classes="ac surface" x:Name="SharedList" SelectionMode="Multiple" SelectionChanged="SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,8" Spacing="4">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                    <TextBlock Text="{Binding MediaType}" FontSize="{DynamicResource UiFontCaption}"/>
                    <TextBlock Text="{Binding Size}" FontSize="{DynamicResource UiFontCaption}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <ac:EmptyState x:Name="EmptySharedList" Text="尚未分享文件" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource AcRowGap}" Margin="0,12,0,0">
              <Button Classes="ac" x:Name="AddSharedButton" Content="添加分享文件" Click="AddSharedClick"/>
              <Button Classes="ac" x:Name="RemoveSharedButton" Content="取消分享" Click="RemoveSharedClick" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="ActivityText" Text="" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
</Window>
