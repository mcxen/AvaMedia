<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:AvaMedia.Desktop" x:Class="AvaMedia.Desktop.WifiTransferWindow"
        Title="WiFi 传文件" Width="1100" Height="800" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Spacing="5" Margin="0,0,0,14">
      <TextBlock Text="WiFi 传文件" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="多位用户连接同一局域网，扫码收发照片、视频和文件；选择左侧用户查看对应媒体。" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,14">
      <TextBlock Text="网络地址" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="NetworkInput" Grid.Column="1" HorizontalAlignment="Stretch" i18n:Localization.IsUserText="True"/>
      <Button x:Name="RefreshNetworkButton" Grid.Column="2" Content="刷新网络" Click="RefreshNetworkClick" Margin="8,0,0,0"/>
      <Button x:Name="StartReceiveButton" Grid.Column="3" Content="开启传输" Click="StartReceiveClick" Margin="8,0,0,0"/>
      <Button x:Name="StopReceiveButton" Grid.Column="4" Content="关闭传输" Click="StopReceiveClick" Margin="8,0,0,0" IsEnabled="False"/>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <CheckBox x:Name="AutoCloseInput" Content="空闲 5 分钟自动关闭" IsChecked="True"
                IsCheckedChanged="AutoCloseChanged" VerticalAlignment="Center"/>
      <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="传输已关闭，点击开启传输后扫码连接。"
                 Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="240,16,*">
      <Border Padding="12" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" CornerRadius="{DynamicResource UiControlRadius}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Text="传输用户" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="UserSummary" Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" FontSize="12"/>
          <ListBox x:Name="UsersList" Grid.Row="2" SelectionChanged="UserSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="5" Margin="4,10">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                  <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Address}" FontSize="12" i18n:Localization.IsUserText="True"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="用户扫码后自动出现，可在手机网页修改名称。" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <TextBlock x:Name="MediaHeading" Text="全部媒体与文件" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Expander x:Name="ConnectionPanel" Grid.Row="1" Header="扫码连接与网络说明" HorizontalAlignment="Stretch" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,16,*" Margin="10">
            <Border Background="White" Padding="8" VerticalAlignment="Top">
              <Image x:Name="QrImage" Width="176" Height="176" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
            <StackPanel Grid.Column="2" Spacing="8">
              <TextBlock Text="手机扫码连接" FontWeight="SemiBold"/>
              <TextBox x:Name="AddressText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" i18n:Localization.IsUserText="True"/>
              <Button x:Name="CopyAddressButton" Content="复制扫码地址" Click="CopyAddressClick" IsEnabled="False"/>
              <TextBlock Text="无法连接时：选择电脑连接路由器的 WiFi / 有线地址；允许应用通过系统防火墙的专用网络，并检查路由器是否隔离设备。" TextWrapping="Wrap" FontSize="12"/>
              <TextBlock Text="临时 HTTP 局域网传输，请在可信网络中使用。关闭传输或窗口后，当前地址失效。" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Expander>
      <TabControl Grid.Row="2">
        <TabItem Header="接收到电脑">
          <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock x:Name="ReceiveSummary" Text="收到的文件会显示在这里。" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <Button Grid.Column="1" Content="打开接收目录" Click="OpenReceiveFolderClick" Margin="10,0,0,0"/>
            </Grid>
            <ListBox x:Name="ReceivedList" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding MediaType}" FontSize="12"/>
                      <TextBlock Text="{Binding UserName}" FontSize="12" i18n:Localization.IsUserText="True"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding Receiving}" Height="5"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,10">
              <Button x:Name="SelectReceivedButton" Content="全选已接收" Click="SelectReceivedClick" IsEnabled="False"/>
              <Button x:Name="ImportReceivedButton" Content="导入转换" Click="ImportReceivedClick" IsEnabled="False"/>
              <Button x:Name="CompressReceivedButton" Content="高画质视频压缩" Click="CompressReceivedClick" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="MOV 等视频可直接导入压缩：默认 HEVC、质量 18，保留分辨率和帧率。接近原画质不等于无损，体积由内容决定；HDR 的处理提示请在压缩窗口查看。" TextWrapping="Wrap" FontSize="12"/>
          </Grid>
        </TabItem>
        <TabItem Header="发送到手机">
          <Grid RowDefinitions="Auto,*,Auto" Margin="10">
            <TextBlock Text="这里的分享文件供所有连接用户下载，手机网页会自动刷新下载列表。" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ListBox x:Name="SharedList" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,8" Spacing="4">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" i18n:Localization.IsUserText="True"/>
                    <TextBlock Text="{Binding MediaType}" FontSize="12"/>
                    <TextBlock Text="{Binding Size}" FontSize="12"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button x:Name="AddSharedButton" Content="添加分享文件" Click="AddSharedClick"/>
              <Button x:Name="RemoveSharedButton" Content="取消分享" Click="RemoveSharedClick" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="ActivityText" Text="接收文件保存在本机，关闭窗口不会删除已接收的文件。" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
</Window>
