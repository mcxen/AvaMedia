<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <x:Double x:Key="CtBasketHeight">144</x:Double>
    <Thickness x:Key="CtBasketPadding">8</Thickness>
    <x:Double x:Key="CtPersonPreviewHeight">180</x:Double>
    <Thickness x:Key="CtWindowMargin">12</Thickness>
    <x:Double x:Key="CtDetailGap">6</x:Double>
    <x:Double x:Key="CtGroupGap">10</x:Double>
    <x:Double x:Key="CtScoreHeight">310</x:Double>
    <x:Double x:Key="CtCurveHeight">230</x:Double>
    <x:Double x:Key="CtTagSourceWidth">212</x:Double>
    <x:Double x:Key="CtScoreModeWidth">132</x:Double>
    <x:Double x:Key="CtTagScopeWidth">128</x:Double>
    <x:Double x:Key="CtTagSortWidth">140</x:Double>
    <x:Double x:Key="CtThresholdWidth">148</x:Double>
    <x:Double x:Key="CtThresholdLabelWidth">110</x:Double>
    <Thickness x:Key="CtTagPadding">9,5</Thickness>
    <Thickness x:Key="CtTagMargin">0,0,6,6</Thickness>
  </Styles.Resources>
  <Style Selector="Window.ai-specialist ListBox.surface"><Setter Property="Background" Value="{DynamicResource UiTransparent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>

  <!-- These templates are scoped to classification controls, independent of the app's button hover chrome. -->
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.classify-pill, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="ClassificationButtonSurface" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Keep the presenter's background clear: the surrounding border owns the card surface. -->
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.classify-pill /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-pill:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-pill:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-pill:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.classify-pill:disabled /template/ Border#ClassificationButtonSurface">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.classify-segment.selected /template/ Border#ClassificationButtonSurface">
    <Setter Property="BoxShadow" Value="{DynamicResource UiSegmentShadow}" />
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.classify-pill:focus-visible /template/ Border#ClassificationButtonSurface, Window:not(.mac-os9):not(.windows-xp) Button.classify-segment:focus-visible /template/ Border#ClassificationButtonSurface">
    <Setter Property="BoxShadow" Value="{DynamicResource UiFocusShadow}" />
  </Style>
  <Style Selector="Window.ai-specialist Button.classification-basket.dragover"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
</Styles>
