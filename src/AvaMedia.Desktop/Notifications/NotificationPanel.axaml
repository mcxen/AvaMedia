<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AvaMedia.Desktop.Notifications.NotificationPanel">
  <UserControl.Styles>
    <Style Selector="Button.notification-action"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,4"/></Style>
    <Style Selector="Border.notification-frame"><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </UserControl.Styles>
  <Border Classes="notification-frame">
    <Border BorderBrush="{DynamicResource UiBevelLight}" BorderThickness="1,1,0,0" CornerRadius="5" Padding="16,12">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
          <StackPanel Spacing="4">
            <TextBlock x:Name="Heading" Classes="title" TextWrapping="Wrap"/>
            <TextBlock x:Name="Timestamp" Classes="caption"/>
          </StackPanel>
          <Button x:Name="RemoveButton" Grid.Column="1" Classes="tool notification-action" Content="移除" Click="RemoveClick" VerticalAlignment="Top" AutomationProperties.Name="移除通知"/>
          <Button x:Name="ClearButton" Grid.Column="2" Classes="tool notification-action" Content="清空" Click="ClearClick" VerticalAlignment="Top" AutomationProperties.Name="清除全部通知" ToolTip.Tip="清除全部通知"/>
          <Button Grid.Column="3" Classes="tool notification-action" Content="×" Click="DismissClick" VerticalAlignment="Top" AutomationProperties.Name="关闭当前通知" ToolTip.Tip="关闭当前通知"/>
        </Grid>
        <ScrollViewer x:Name="MessageScroll" Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="{DynamicResource UiFontBody}" LineHeight="22" Foreground="{DynamicResource UiText}"/>
        </ScrollViewer>
        <ListBox x:Name="HistoryList" Grid.Row="1" MaxHeight="230" SelectionChanged="HistorySelectionChanged" IsVisible="False"/>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="暂无通知" Classes="caption" Margin="0,12" IsVisible="False"/>
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Spacing="6" IsVisible="False">
          <ProgressBar x:Name="ProgressBar" Maximum="100" Height="8"/>
          <TextBlock x:Name="ProgressText" Classes="caption"/>
        </StackPanel>
        <WrapPanel x:Name="Actions" Grid.Row="3"/>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="Previous" Classes="tool notification-action" Content="‹" Click="PreviousClick" AutomationProperties.Name="上一条通知"/>
            <TextBlock x:Name="Counter" VerticalAlignment="Center" Classes="caption"/>
            <Button x:Name="Next" Classes="tool notification-action" Content="›" Click="NextClick" AutomationProperties.Name="下一条通知"/>
          </StackPanel>
          <Button x:Name="HistoryButton" Grid.Column="1" Classes="tool notification-action" Content="所有通知" Click="HistoryClick"/>
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
