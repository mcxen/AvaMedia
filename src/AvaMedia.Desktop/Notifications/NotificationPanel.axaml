<UserControl xmlns:local="using:AvaMedia.Desktop.Controls" xmlns:ac="using:AvaMedia.Controls" xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AvaMedia.Desktop.Notifications.NotificationPanel">
  <UserControl.Styles>

    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,2"/></Style>
  </UserControl.Styles>
  <Border x:Name="NoticeFrame" Classes="ac-notice">
    <Border>
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <ac:StatusGlyph x:Name="NoticeGlyph" State="empty" Width="16" Height="16" VerticalAlignment="Center"/>
          <TextBlock x:Name="Heading" Grid.Column="1" FontSize="{DynamicResource UiFontBody}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <TextBlock x:Name="Timestamp" Grid.Column="2" Classes="caption" VerticalAlignment="Center"/>
          <Button Grid.Column="3" Classes="ac tool notification-action notification-icon icon borderless small" Click="DismissClick" VerticalAlignment="Top" AutomationProperties.Name="关闭当前通知" ToolTip.Tip="关闭当前通知"><local:LucideIcon Kind="x" Width="14" Height="14"/></Button>
        </Grid>
        <ScrollViewer x:Name="MessageScroll" MaxHeight="144" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="{DynamicResource UiFontBody}" LineHeight="18" Foreground="{DynamicResource UiText}"/>
        </ScrollViewer>
        <ListBox x:Name="HistoryList" MaxHeight="230" SelectionChanged="HistorySelectionChanged" IsVisible="False"/>
        <ac:EmptyState x:Name="EmptyText" Text="暂无通知" Margin="0,4" IsVisible="False"/>
        <Grid x:Name="ProgressPanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
          <ProgressBar Classes="ac" x:Name="ProgressBar" Maximum="100" VerticalAlignment="Center"/>
          <ac:StatusPill x:Name="ProgressText" Grid.Column="1" State="running" VerticalAlignment="Center"/>
        </Grid>
        <WrapPanel x:Name="Actions"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Grid x:Name="Navigation" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2">
            <Button x:Name="Previous" Classes="ac tool notification-action notification-icon icon borderless small" Click="PreviousClick" AutomationProperties.Name="上一条通知" ToolTip.Tip="上一条通知"><local:LucideIcon Kind="chevron-left" Width="14" Height="14"/></Button>
            <TextBlock FontFeatures="tnum" x:Name="Counter" Grid.Column="1" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Classes="caption"/>
            <Button x:Name="Next" Grid.Column="2" Classes="ac tool notification-action notification-icon icon borderless small" Click="NextClick" AutomationProperties.Name="下一条通知" ToolTip.Tip="下一条通知"><local:LucideIcon Kind="chevron-right" Width="14" Height="14"/></Button>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="RemoveButton" Classes="ac tool notification-action notification-utility borderless small" Content="移除" Click="RemoveClick" AutomationProperties.Name="移除通知"/>
            <Button x:Name="ClearButton" Classes="ac tool notification-action notification-utility borderless small" Content="清空" Click="ClearClick" AutomationProperties.Name="清除全部通知"/>
            <Button x:Name="HistoryButton" i18n:StableLayout.Samples="所有通知|收起" Classes="ac tool notification-action notification-utility borderless small" Content="所有通知" Click="HistoryClick"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
