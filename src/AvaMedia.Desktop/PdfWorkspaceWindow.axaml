<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaMedia.Desktop.PdfWorkspaceWindow" Width="1260" Height="840" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.pdf-card"><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/></Style>
    <Style Selector="Border.pdf-card.active"><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBorder}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Border.pdf-card.cut"><Setter Property="Background" Value="{DynamicResource UiSelection}"/></Style>
  </Window.Styles>
  <Grid Margin="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="WorkspaceTitle" Classes="title" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="AddButton" Content="添加文件…" Click="AddClick"/>
      <Button Grid.Column="2" x:Name="ClearButton" Content="清空" Click="ClearClick"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="14">
      <Border Background="{DynamicResource UiSurfaceRaised}" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="SelectAllButton" Content="全选" Click="SelectAllClick"/>
            <Button Grid.Column="1" x:Name="InvertButton" Content="反选" Click="InvertClick"/>
            <Button Grid.Column="2" x:Name="UndoButton" Content="撤销" Click="UndoClick" IsEnabled="False"/>
            <TextBlock Grid.Column="4" x:Name="PageSummary" Classes="caption" VerticalAlignment="Center"/>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <WrapPanel x:Name="PageBoard" Orientation="Horizontal"/>
              <TextBlock x:Name="EmptyText" Text="添加文件" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap"/>
            </Grid>
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="PreviousButton" Content="上一组" Click="PreviousClick"/>
            <TextBlock Grid.Column="1" x:Name="BoardRange" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="NextButton" Content="下一组" Click="NextClick"/>
          </Grid>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <TextBlock x:Name="PreviewTitle" Text="页面预览" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Border Background="{DynamicResource UiSurfaceRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Height="280" Padding="10">
            <Image x:Name="PagePreview" Stretch="Uniform"/>
          </Border>
          <StackPanel x:Name="LayoutPanel" Spacing="8" IsVisible="False">
            <TextBlock Text="页面排版" FontWeight="SemiBold"/>
            <ComboBox x:Name="PaperSizeSetting" SelectionChanged="LayoutChanged"><ComboBoxItem Content="A4"/><ComboBoxItem Content="Letter"/><ComboBoxItem x:Name="SourceSizeItem" Content="原图尺寸"/></ComboBox>
            <CheckBox x:Name="LandscapeSetting" Content="横向页面" IsCheckedChanged="LayoutChanged"/>
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="页边距（pt）" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="PageMargin" Minimum="0" Maximum="144" Value="20" FormatString="0" ValueChanged="LayoutChanged"/></Grid>
            <Grid x:Name="FontSizeRow" ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="字号（pt）" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="TextFontSize" Minimum="6" Maximum="48" Value="12" FormatString="0" ValueChanged="LayoutChanged"/></Grid>
          </StackPanel>
          <StackPanel x:Name="SplitPanel" Spacing="8" IsVisible="False">
            <TextBlock Text="拆分方式" FontWeight="SemiBold"/>
            <ComboBox x:Name="SplitMode" SelectionChanged="SplitModeChanged">
              <ComboBoxItem Content="按拆分点"/>
              <ComboBoxItem Content="每页一个文件"/>
              <ComboBoxItem Content="所选页面合为一个文件"/>
            </ComboBox>
            <Grid ColumnDefinitions="*,96,Auto" ColumnSpacing="8">
              <TextBlock Text="每组页数" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Column="1" x:Name="GroupSize" Minimum="1" Maximum="10000" Value="5" FormatString="0"/>
              <Button Grid.Column="2" Content="应用" Click="GroupClick"/>
            </Grid>
            <TextBlock x:Name="GroupSummary" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ExtractionPanel" Spacing="8" IsVisible="False">
            <TextBlock Text="提取内容" FontWeight="SemiBold"/>
            <TextBlock Text="只提取文字；扫描页需要 OCR，不恢复原排版。" Classes="caption" TextWrapping="Wrap"/>
            <TextBox x:Name="ExtractedText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160"/>
          </StackPanel>
          <StackPanel x:Name="AgePanel" Spacing="8" IsVisible="False">
            <TextBlock Text="纸张风格" FontWeight="SemiBold"/>
            <ComboBox x:Name="PaperStyle" SelectionChanged="EffectChanged"><ComboBoxItem Content="暖色纸张"/><ComboBoxItem Content="黑白复印"/><ComboBoxItem Content="泛黄旧纸"/></ComboBox>
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="做旧强度" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="AgeAmount" Minimum="0" Maximum="100" Value="35" FormatString="0" ValueChanged="EffectChanged"/></Grid>
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="颗粒" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="GrainAmount" Minimum="0" Maximum="100" Value="15" FormatString="0" ValueChanged="EffectChanged"/></Grid>
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="倾斜角度" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="SkewAmount" Minimum="-2" Maximum="2" Increment="0.1" Value="0.2" FormatString="0.0" ValueChanged="EffectChanged"/></Grid>
          </StackPanel>
          <StackPanel x:Name="CompressPanel" Spacing="8" IsVisible="False">
            <TextBlock Text="压缩档位" FontWeight="SemiBold"/>
            <ComboBox x:Name="CompressionPreset" SelectionChanged="CompressionPresetChanged"><ComboBoxItem Content="清晰优先"/><ComboBoxItem Content="平衡"/><ComboBoxItem Content="体积优先"/><ComboBoxItem Content="自定义"/></ComboBox>
            <CheckBox x:Name="RasterizeSetting" Content="整页压缩" IsCheckedChanged="EffectChanged"/>
            <TextBlock Text="默认保留文字并压缩图片；整页压缩会移除可搜索文字、表单和链接。" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="RasterSettings" Spacing="8" IsVisible="False">
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="JPEG 质量" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="JpegQuality" Minimum="10" Maximum="100" Value="75" FormatString="0" ValueChanged="EffectChanged"/></Grid>
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8"><TextBlock Text="最长边（像素）" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" x:Name="RasterEdge" Minimum="600" Maximum="4096" Increment="100" Value="1800" FormatString="0" ValueChanged="EffectChanged"/></Grid>
            <TextBlock x:Name="RasterNote" Text="做旧输出为图像页面，不保留可搜索文字、表单和链接。" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <TextBlock Text="保存到" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" x:Name="OutputFolder"/>
      <Button Grid.Column="2" Content="浏览…" Click="BrowseClick"/>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Classes="caption" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="取消" Classes="dialog-action" IsCancel="True" Click="CancelClick"/>
      <Button Grid.Column="2" x:Name="ConfirmButton" Content="加入队列" Classes="primary dialog-action" IsDefault="True" IsEnabled="False" Click="ConfirmClick"/>
    </Grid>
  </Grid>
</Window>
