<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:AvaMedia.Desktop" x:Class="AvaMedia.Desktop.VideoSlimmingWindow"
        Title="视频瘦身" Width="960" Height="660" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource UiPagePadding}" RowSpacing="12">
    <StackPanel x:Name="OptionsPanel" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="添加视频…" Click="AddClick"/>
        <Button Content="添加文件夹…" Click="FolderClick"/>
        <Button Content="移除选中" Click="RemoveClick"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <ComboBox x:Name="PresetInput" AutomationProperties.Name="瘦身档位"/>
        <ComboBox x:Name="CodecInput" Grid.Column="1" AutomationProperties.Name="视频编码"/>
        <ComboBox x:Name="FormatInput" Grid.Column="2" AutomationProperties.Name="输出格式"/>
      </Grid>
      <TextBlock Classes="caption" Text="保持分辨率、帧率和全部声音；预计体积来自采样。" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" Background="{DynamicResource UiSurface}">
      <ListBox x:Name="SourceList" SelectionMode="Multiple" BorderThickness="0" AutomationProperties.Name="瘦身视频">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="5" Margin="8,10">
              <TextBlock Text="{Binding Name}" i18n:Localization.IsUserText="True" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
              <TextBlock Classes="caption" Text="{Binding SourceSummary}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap"/>
              <TextBlock Classes="caption" Text="{Binding QualitySummary}" TextWrapping="Wrap"/>
              <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <StackPanel Grid.Row="2" Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Text="保存位置" VerticalAlignment="Center"/>
        <TextBox x:Name="OutputInput" Grid.Column="1" AutomationProperties.Name="输出文件夹" i18n:Localization.IsUserText="True"/>
        <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" Click="BrowseClick" Classes="field-action"/>
      </Grid>
      <CheckBox x:Name="SourceFolderInput" Content="输出至源文件目录"/>
      <TextBlock x:Name="SummaryText" Classes="caption" TextWrapping="Wrap"/>
      <ProgressBar x:Name="AnalysisProgress" Minimum="0" Maximum="100" IsVisible="False"/>
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
      <TextBlock x:Name="StatusText" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button x:Name="AnalyzeButton" Grid.Column="1" Content="分析体积" Click="AnalyzeClick" Classes="dialog-action"/>
      <Button Grid.Column="2" Content="取消" Click="CancelClick" IsCancel="True" Classes="dialog-action"/>
      <Button x:Name="ConfirmButton" Grid.Column="3" Content="加入队列" Click="ConfirmClick" IsDefault="True" Classes="dialog-action primary"/>
    </Grid>
  </Grid>
</Window>
