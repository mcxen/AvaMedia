<Window xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaMedia.Desktop" xmlns:controls="using:AvaMedia.Desktop.Controls"
        x:Class="AvaMedia.Desktop.BatchCropWindow" Title="视频批量裁剪" Width="1200" Height="800"
        MinWidth="940" MinHeight="640" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="28"/></Style>
    <Style Selector="TextBlock.cropValidation"><Setter Property="Foreground" Value="{DynamicResource UiText}"/></Style>
    <Style Selector="TextBlock.cropValidation.error"><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="{DynamicResource UiPagePadding}" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddButton" Content="添加视频…" Click="AddClick"/>
        <Button x:Name="RemoveButton" Content="移除选中" Click="RemoveClick"/>
        <Button x:Name="SelectAllButton" Content="全选" Click="SelectAllClick"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="12">
      <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="{DynamicResource UiControlRadius}">
        <Grid RowDefinitions="Auto,*">
          <TextBlock x:Name="ListSummary" Text="尚未添加视频" Margin="12,8"/>
          <ListBox Grid.Row="1" x:Name="FileList" Background="Transparent" BorderThickness="0" SelectionMode="Multiple"
                   SelectionChanged="FileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="批量裁剪视频列表">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="local:BatchCropEntry">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="6" Margin="0,6">
                  <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" AutomationProperties.Name="是否裁剪此视频"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock i18n:Localization.IsUserText="True" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                    <TextBlock Text="{Binding Dimensions}" Classes="caption"/>
                    <TextBlock Text="{Binding Status}" FontSize="{DynamicResource UiFontCaption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto" RowSpacing="8">
        <Border Background="{DynamicResource UiMediaSurface}" CornerRadius="{DynamicResource UiControlRadius}" ClipToBounds="True">
          <Grid x:Name="PreviewArea">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
            <controls:CropOverlay x:Name="CropLayer"/>
            <TextBlock x:Name="PreviewStatus" Text="尚未选择视频" Foreground="{DynamicResource UiMediaText}"
                       TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Slider Grid.Row="1" x:Name="PreviewSeek" Minimum="0" Maximum="1" Value="0" IsEnabled="False" AutomationProperties.Name="裁剪预览时间"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,140,Auto" ColumnSpacing="8">
          <TextBlock x:Name="PreviewName" Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" x:Name="CropRatio" SelectionChanged="RatioChanged" AutomationProperties.Name="批量裁剪选区比例" ToolTip.Tip="约束新选区及四角缩放的比例"/>
          <Button Grid.Column="2" Content="重置为当前全画面" Click="ResetClick"/>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" CornerRadius="{DynamicResource UiControlRadius}" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock x:Name="ReferenceText" Text="选区参考：尚未选择视频" Classes="caption"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="应用到勾选视频" VerticalAlignment="Center"/><ComboBox x:Name="ModeCombo" SelectionChanged="ModeChanged" AutomationProperties.Name="裁剪区域应用方式" MinWidth="220"/></StackPanel>
        <Expander Header="精确坐标" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
          <TextBlock Text="X" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" x:Name="CropXInput" Minimum="0" Maximum="2147483647" Increment="2" Value="0" FormatString="0" AutomationProperties.Name="裁剪区域 X"/>
          <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="3" x:Name="CropYInput" Minimum="0" Maximum="2147483647" Increment="2" Value="0" FormatString="0" AutomationProperties.Name="裁剪区域 Y"/>
          <TextBlock Grid.Column="4" Text="宽度" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="5" x:Name="CropWidthInput" Minimum="0" Maximum="2147483647" Increment="2" Value="0" FormatString="0" AutomationProperties.Name="裁剪区域宽度"/>
          <TextBlock Grid.Column="6" Text="高度" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="7" x:Name="CropHeightInput" Minimum="0" Maximum="2147483647" Increment="2" Value="0" FormatString="0" AutomationProperties.Name="裁剪区域高度"/>
        </Grid>
        </Expander>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,160,Auto,*,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Text="输出格式" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" x:Name="FormatCombo" SelectionChanged="FormatChanged" AutomationProperties.Name="裁剪输出格式"/>
      <TextBlock Grid.Column="2" Text="保存位置" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <TextBox Grid.Column="3" x:Name="OutputInput" AutomationProperties.Name="批量裁剪输出文件夹"/>
      <Button Grid.Column="4" x:Name="BrowseOutputButton" Content="浏览…" Click="BrowseClick" Classes="field-action"/>
      <Button Grid.Column="5" x:Name="OutputOptionsButton" Content="输出配置…" Click="OptionsClick"/>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="18"><CheckBox x:Name="SourceOutputInput" Content="输出至源文件目录"/><CheckBox x:Name="SettingNameInput" Content="添加设置名称"/></StackPanel>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="6" x:Name="ExportHint" Classes="caption" TextWrapping="Wrap"/>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBlock x:Name="ValidationText" Classes="cropValidation" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="取消" Click="CancelClick" IsCancel="True" Classes="dialog-action"/>
      <Button Grid.Column="2" x:Name="OkButton" Content="加入队列" Click="ConfirmClick" IsDefault="True" Classes="primary dialog-action" IsEnabled="False"/>
    </Grid>
  </Grid>
</Window>
