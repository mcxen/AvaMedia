<Window xmlns:controls="using:AvaMedia.Desktop.Controls" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:AvaMedia.Desktop" x:Class="AvaMedia.Desktop.VideoCompressionWindow"
        Title="视频压缩" Width="1120" Height="800" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto,Auto" Margin="{DynamicResource UiPagePadding}" RowSpacing="12">
    <Grid ColumnDefinitions="*,360" ColumnSpacing="12">
      <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" Background="{DynamicResource UiSurface}">
        <Grid RowDefinitions="Auto,*,240,Auto" Margin="12" RowSpacing="8">
          <WrapPanel Orientation="Horizontal">
            <WrapPanel.Styles><Style Selector="Button"><Setter Property="Margin" Value="0,0,8,4"/></Style></WrapPanel.Styles>
            <Button Content="添加视频…" Click="AddClick"/>
            <Button Content="添加文件夹…" Click="FolderClick"/>
            <Button x:Name="RemoveButton" Content="移除选中" Click="RemoveClick" IsEnabled="False"/>
            <Button x:Name="RemoveInvalidButton" Content="移除错误文件" Click="RemoveInvalidClick" IsEnabled="False"/>
          </WrapPanel>
          <Grid Grid.Row="1">
          <ListBox x:Name="SourceList" SelectionMode="Multiple" BorderThickness="0" AutomationProperties.Name="批量压缩视频" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="4" Margin="4,8">
                  <TextBlock Text="{Binding Name}" i18n:Localization.IsUserText="True" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                  <TextBlock Classes="caption" Text="{Binding SourceSummary}" TextWrapping="Wrap"/>
                  <TextBlock Classes="caption" Text="{Binding ColorSummary}" IsVisible="{Binding HasColorChange}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"/>
                  <TextBlock Classes="caption" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap"/>
                  <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Text="添加或拖入视频" Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="8"><ContentControl x:Name="PreviewHost"/><controls:SizeComparisonView x:Name="SizeChart" Grid.Row="1"/></Grid>
          <TextBlock x:Name="TotalSummary" Grid.Row="3" Classes="caption" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1" Background="{DynamicResource UiSurfaceRaised}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="压缩方式"/>
            <ComboBox x:Name="ModeInput" AutomationProperties.Name="压缩模式"/>
            <StackPanel x:Name="AutoSection" Spacing="6">
              <TextBlock Text="画质档位"/>
              <ComboBox x:Name="PresetInput" AutomationProperties.Name="画质档位"/>
              <TextBlock x:Name="PresetDescription" Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="QualitySection" Spacing="6" IsVisible="False">
              <TextBlock Text="质量（1–51）"/>
              <NumericUpDown x:Name="QualityInput" Minimum="1" Maximum="51" Increment="1" Value="23" FormatString="0" AutomationProperties.Name="质量（1–51）"/>
              <controls:ParameterSlider Input="{Binding #QualityInput}"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Content="高 · 20" Click="HighQualityClick"/>
                <Button Grid.Column="1" Content="中 · 23" Click="MediumQualityClick"/>
                <Button Grid.Column="2" Content="低 · 28" Click="LowQualityClick"/>
              </Grid>
              <TextBlock Classes="caption" Text="数值越小，画质越高" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="BitrateSection" Spacing="6" IsVisible="False">
              <TextBlock Text="视频平均码率（kbps）"/>
              <NumericUpDown x:Name="BitrateInput" Minimum="64" Maximum="200000" Increment="500" Value="4000" FormatString="0" AutomationProperties.Name="视频平均码率（kbps）"/>
              <controls:ParameterSlider Input="{Binding #BitrateInput}"/>
              <ComboBox x:Name="BitratePresetInput" AutomationProperties.Name="常用视频码率"/>
            </StackPanel>
            <StackPanel x:Name="PercentageSection" Spacing="6">
              <TextBlock Text="目标体积（原文件 %）"/>
              <NumericUpDown x:Name="PercentageInput" Minimum="5" Maximum="95" Increment="5" Value="60" FormatString="0" AutomationProperties.Name="目标体积（原文件 %）"/>
              <controls:ParameterSlider Input="{Binding #PercentageInput}"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button Content="轻量 80%" Click="LightClick"/>
                <Button Grid.Column="1" Content="均衡 60%" Click="BalancedClick"/>
                <Button Grid.Column="2" Content="更小 40%" Click="SmallClick"/>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="SizeSection" Spacing="6" IsVisible="False">
              <TextBlock Text="每个视频的目标体积（MB）"/>
              <NumericUpDown x:Name="SizeInput" Minimum="0.1" Maximum="1000000" Increment="5" Value="50" FormatString="0.##" AutomationProperties.Name="每个视频的目标体积（MB）"/>
              <controls:ParameterSlider Input="{Binding #SizeInput}"/>
            </StackPanel>
            <TextBlock x:Name="ModeDescription" Classes="caption" TextWrapping="Wrap"/>
            <Expander x:Name="OutputOptions" Header="输出参数" HorizontalAlignment="Stretch">
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="输出格式"/>
                <ComboBox x:Name="FormatInput" AutomationProperties.Name="输出格式"/>
                <TextBlock Text="视频编码"/>
                <ComboBox x:Name="CodecInput" AutomationProperties.Name="视频编码"/>
                <TextBlock Text="分辨率上限"/>
                <ComboBox x:Name="ResolutionInput" AutomationProperties.Name="分辨率上限"/>
                <TextBlock Text="帧率上限"/>
                <ComboBox x:Name="FrameRateInput" AutomationProperties.Name="帧率上限"/>
                <CheckBox x:Name="KeepAudioInput" Content="保留声音" IsChecked="True"/>
                <ComboBox x:Name="AudioInput" AutomationProperties.Name="音频码率"/>
                <TextBlock Text="编码速度"/>
                <ComboBox x:Name="SpeedInput" AutomationProperties.Name="编码速度"/>
                <CheckBox x:Name="GpuInput" Content="优先 GPU 编码" IsChecked="True"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Text="保存位置" VerticalAlignment="Center"/>
        <TextBox x:Name="OutputInput" Grid.Column="1" AutomationProperties.Name="输出文件夹" IsReadOnly="True"/>
        <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" Click="BrowseClick" Classes="field-action"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="SourceFolderInput" Content="输出至源文件目录"/>
        <CheckBox x:Name="SettingNameInput" Content="添加设置名称"/>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock x:Name="ValidationText" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button Content="取消" Classes="dialog-action" IsCancel="True" Click="CancelClick"/>
        <Button x:Name="ConfirmButton" Content="加入队列" Classes="dialog-action primary" IsDefault="True" IsEnabled="False" Click="ConfirmClick"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
