<Window xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls"
        x:Class="AvaMedia.Desktop.DownloadWindow" Title="视频下载" Width="1120" Height="860" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
      <local:FeatureIcon Kind="download" Width="48" Height="48"/>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="DownloadHeading" Text="视频下载" FontSize="{DynamicResource UiFontHeading}"/></StackPanel>
      <TextBlock Grid.Column="2" x:Name="EngineStatus" Classes="caption" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="16">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="YouTube   ·   哔哩哔哩   ·   抖音   ·   小红书   ·   Bunkr   ·   Pixeldrain" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="PasteLinksButton" Content="粘贴分享文本" Click="PasteClick"/></Grid>
        <TextBox Grid.Row="1" x:Name="LinksInput" AcceptsReturn="True" Height="74" TextWrapping="Wrap" Watermark="可粘贴多个链接，也可直接粘贴抖音 / 小红书的完整分享文本。"/>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
          <Button x:Name="InspectButton" Content="解析链接" Click="InspectClick"/>
          <Button Grid.Column="1" x:Name="CancelInspectButton" Content="取消解析" Click="CancelInspectClick" IsVisible="False"/>
          <Button Grid.Column="2" x:Name="ClearLinksButton" Content="清空" Click="ClearClick"/>
          <Button Grid.Column="3" x:Name="RetryFailedButton" Content="重试失败项" Click="RetryFailedClick" IsEnabled="False"/>
          <TextBlock Grid.Column="4" x:Name="InspectStatus" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="20">
      <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="待下载视频" FontSize="{DynamicResource UiFontTitle}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="SelectAllCheck" Content="全选" IsCheckedChanged="SelectAllChanged"/></Grid>
          <Grid Grid.Row="1">
            <ListBox x:Name="DownloadList" SelectionChanged="VideoSelected" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,10">
                    <CheckBox IsChecked="{Binding IsChecked,Mode=TwoWay}" IsEnabled="{Binding IsReady}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock i18n:Localization.IsUserText="True" Text="{Binding Title}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding DisplayUrl}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ErrorSummary}" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="移除" Click="RemoveVideoClick" VerticalAlignment="Top"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="350">
              <TextBlock Text="尚无视频" FontSize="{DynamicResource UiFontTitle}" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" x:Name="SelectionSummary" Classes="caption" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource UiSurfaceRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="16">
        <ScrollViewer x:Name="DownloadOptionsScroll">
          <StackPanel x:Name="DownloadSettingsPanel" Spacing="10">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="下载选项" FontSize="{DynamicResource UiFontTitle}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="NetworkSettingsButton" Content="登录 / 代理" Click="NetworkSettingsClick"/></Grid>
            <TextBlock Text="保存内容"/><ComboBox x:Name="DownloadFormat" SelectionChanged="FormatChanged"/>
            <TextBlock Text="最高画质"/><ComboBox x:Name="DownloadQuality"/>
            <TextBlock Text="字幕"/><ComboBox x:Name="DownloadSubtitles"/>
            <CheckBox x:Name="SaveMetadata" Content="保留标题和作者元数据" IsChecked="True"/>
            <CheckBox x:Name="ExpandPlaylist" Content="展开播放列表 / 分P / 相册"/>
            <TextBlock x:Name="PlaylistLimit" Text="最多展开 100 项" Classes="caption" TextWrapping="Wrap"/>
            <Border Height="1" Background="{DynamicResource UiDivider}" Margin="0,4"/>
            <TextBlock Text="登录与网络" FontSize="{DynamicResource UiFontTitle}"/>
            <TextBlock Text="使用登录态"/><ComboBox x:Name="CookieSource" SelectionChanged="CookieSourceChanged"/>
            <StackPanel x:Name="CookieFilePanel" IsVisible="False" Spacing="6"><TextBox x:Name="CookieFileInput" Watermark="Netscape 格式 cookies.txt"/><Button Content="选择 cookies.txt…" Click="CookieFileClick"/></StackPanel>
            <TextBlock Text="无法读取 Chrome / Edge 登录态时，可使用 Firefox 或 cookies.txt。" Classes="caption" TextWrapping="Wrap"/>
            <TextBlock Text="代理（可选）"/><TextBox x:Name="DownloadProxy" Watermark="http://127.0.0.1:7890"/>
            <TextBlock x:Name="PlatformHelp" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3" x:Name="DownloadOutputFields" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <TextBlock Text="保存位置" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DownloadFolder"/><Button Grid.Column="2" x:Name="BrowseDownloadFolderButton" Content="浏览…" Click="BrowseFolderClick"/>
      <TextBlock Grid.Row="1" x:Name="OutputNameLabel" Text="文件名" VerticalAlignment="Center" IsVisible="False"/>
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="DownloadOutputName" IsVisible="False"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DownloadExtension" VerticalAlignment="Center" IsVisible="False"/>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBlock x:Name="DownloadError" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="DownloadCancelButton" Content="取消" Click="CancelClick" IsCancel="True" Classes="dialog-action"/>
      <Button Grid.Column="2" x:Name="AddDownloadsButton" Content="加入下载队列" Click="ConfirmClick" IsDefault="True" Classes="primary dialog-action" IsEnabled="False"/>
    </Grid>
  </Grid>
</Window>
