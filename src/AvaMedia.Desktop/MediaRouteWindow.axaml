<Window xmlns:ac="using:AvaMedia.Controls" xmlns:files="using:AvaMedia.FileUi" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.MediaRouteWindow"
        Classes="file-router" Title="文件路由" Width="1140" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.route-card">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="{DynamicResource UiRouteCardHeight}"/>
      <Setter Property="Padding" Value="{DynamicResource AcCardPadding}"/>
      <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AcCardRadius}"/>
    </Style>
    <Style Selector="Button.route-card.active">
      <Setter Property="Background" Value="{DynamicResource UiHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="Button.route-card:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.route-source">
      <Setter Property="Padding" Value="{DynamicResource UiCompactButtonPadding}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AcCardRadius}"/>
    </Style>
    <Style Selector="Border.route-source.accepted">
      <Setter Property="Background" Value="{DynamicResource UiHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="TextBlock.route-group.active, TextBlock.route-disposition.accepted">
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
  </Window.Styles>
  <Grid Margin="{DynamicResource UiPagePadding}" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource UiSpacingMedium}">
    <Grid ColumnDefinitions="*,Auto">
      <files:FileImportActions x:Name="ImportPanel" HorizontalAlignment="Left" AllowFolders="True"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{DynamicResource UiRouteSourceWidth}"/>
        <ColumnDefinition Width="{DynamicResource UiRouteFlowWidth}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Classes="ac-card">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource UiSpacingSmall}" Margin="{DynamicResource UiRouteCardPadding}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="输入文件" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceCount" Grid.Column="1" Classes="caption"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="快速勾选"/>
            <ComboBox Classes="ac" x:Name="KindPicker" Grid.Column="1" AutomationProperties.Name="快速勾选文件类型"/>
          </Grid>
          <ListBox x:Name="SourceList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="输入文件预览"/>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Grid.Column="1" Content="取消勾选" Click="DeselectClick" Classes="ac field-action"/>
          </Grid>
        </Grid>
      </Border>
      <controls:MediaRouteFlow Grid.Column="1" x:Name="RouteFlow" ClipToBounds="True" IsHitTestVisible="False" LineBrush="{DynamicResource UiDivider}"
                              ActivateDuration="{StaticResource MotionNavigate}" FadeDuration="{StaticResource MotionFast}"
                              AccentBrush="{DynamicResource UiAccent}" SurfaceBrush="{DynamicResource UiSurface}"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="{DynamicResource UiSpacingSmall}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="选择工具" FontWeight="SemiBold"/>
          <TextBlock x:Name="RouteCount" Grid.Column="1" Classes="caption"/>
        </Grid>
        <ScrollViewer x:Name="RouteScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="RouteSections" Spacing="{DynamicResource UiSpacingMedium}"/>
        </ScrollViewer>
        <ac:EmptyState x:Name="EmptyText" Grid.Row="1" Text="尚未选择文件"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="DestinationTitle" FontWeight="SemiBold"/>
          <TextBlock x:Name="DestinationSummary" Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="取消" IsCancel="True" Classes="ac dialog-action" Click="CancelClick"/>
        <Button x:Name="OpenButton" Grid.Column="2" Content="进入工具" IsDefault="True" Classes="ac dialog-action primary" Click="OpenClick"/>
      </Grid>
    </Border>
  </Grid>
</Window>
