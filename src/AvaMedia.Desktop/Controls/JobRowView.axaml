<UserControl xmlns:ac="using:AvaMedia.Controls" xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.Controls.JobRowView">
  <UserControl.Styles>
    <Style Selector="Button.queue-cover-button"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="8,0,12,0"/></Style>
    <Style Selector="StackPanel.queue-details"><Setter Property="Margin" Value="8,2"/></Style>
    <Style Selector="TextBlock.queue-secondary"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>

    <Style Selector="TextBlock.queue-state"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="TextBlock.queue-state.running"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-state.completed"><Setter Property="Foreground" Value="{DynamicResource UiSuccess}"/></Style>
    <Style Selector="TextBlock.queue-state.failed"><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>
    <Style Selector="TextBlock.queue-state.cancelled"><Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>
    <Style Selector="Window.windows-xp ListBoxItem:selected TextBlock.queue-secondary, Window.windows-xp ListBoxItem:selected TextBlock.queue-state"><Setter Property="Foreground" Value="White"/></Style>
  </UserControl.Styles>
  <Grid Classes="queue-row" x:Name="RowRoot" MinHeight="{DynamicResource UiQueueRowHeight}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource UiQueuePreviewWidth}"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
    <Button x:Name="CoverButton" Classes="media-action queue-cover-button" VerticalAlignment="Center" Height="{DynamicResource UiQueueCoverHeight}" Click="CoverClick">
      <Border Classes="queue-artwork" ClipToBounds="True"><Grid Width="{DynamicResource UiQueueArtworkWidth}" Height="{DynamicResource UiQueueArtworkHeight}" ClipToBounds="True">
        <Border Background="{DynamicResource UiSurfaceRaised}"/>
        <local:FeatureIcon Kind="{Binding Icon}" Label="{Binding PreviewExtension}" Width="{DynamicResource UiQueueIconWidth}" Height="{DynamicResource UiQueueIconHeight}" IsVisible="{Binding NoCover}"/>
        <Image x:Name="CoverImage" Classes="queue-cover" Source="{Binding Cover}" Stretch="Uniform"/>
        <Border x:Name="CoverDragGrip" Background="{DynamicResource UiMediaOverlay}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False" IsHitTestVisible="False">
          <TextBlock Text="⋮⋮" Foreground="{DynamicResource UiMediaText}" FontSize="12"/>
        </Border>
        <Border Background="{DynamicResource UiMediaOverlay}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasCover}">
          <TextBlock Text="▶" Foreground="{DynamicResource UiMediaText}" FontSize="12"/>
        </Border>
      </Grid></Border>
    </Button>
    <StackPanel Classes="queue-details" Grid.Column="1" VerticalAlignment="Center">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="queue-name" i18n:Localization.IsUserText="True" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.Source}"/>
        <TextBlock Grid.Column="1" Text="{Binding Job.SubmittedBy}" Classes="queue-secondary" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{Binding MetaLine}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary modern-only" ToolTip.Tip="{Binding FileSummary}"/>
      <StackPanel Classes="classic-only" ToolTip.Tip="{Binding FileSummary}">
        <TextBlock Text="{Binding MediaSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
        <TextBlock Text="{Binding CodecSummary}" IsVisible="{Binding HasCodecSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
        <TextBlock Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary non-platinum"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Classes="queue-details" Grid.Column="2" VerticalAlignment="Center">
      <Grid x:Name="OutputDragHandle" ColumnDefinitions="Auto,*" ColumnSpacing="4" Background="Transparent">
        <TextBlock x:Name="OutputDragGrip" Text="⋮⋮" Classes="queue-secondary" IsVisible="False" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Classes="classic-only" i18n:Localization.IsUserText="True" Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.UserOutput}"/>
        <TextBlock Grid.Column="1" Classes="modern-only queue-target" i18n:Localization.IsUserText="True" Text="{Binding TargetLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}"/>
      </Grid>
      <TextBlock Classes="classic-only queue-secondary" Text="{Binding SettingsSummary}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}" FontSize="{DynamicResource UiFontCaption}"/>
      <Grid Classes="queue-status" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
      <Grid x:Name="ProgressSlot" Classes="queue-progress" Grid.ColumnSpan="2">
        <ProgressBar Classes="ac" x:Name="PipelineProgress" Value="{Binding Job.Progress}" Maximum="100" Height="{DynamicResource AcProgressHeight}"/>
        <local:AiActivityView x:Name="ActivityView" Compact="True"/>
      </Grid>
      <Grid Classes="queue-state-slot" Grid.Row="1" Grid.ColumnSpan="2" Height="28">
      <Grid x:Name="StateLine" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" ToolTip.Tip="{Binding StateTip}">
        <ac:StatusPill x:Name="TaskStatePill" Classes="modern-only"/>
        <Border IsVisible="False" VerticalAlignment="Center"><local:LucideIcon x:Name="StateIcon" Classes="queue-state-icon" Kind="{Binding StateIcon}" IsVisible="{Binding HasStateIcon}" Width="12" Height="12"/></Border>
        <TextBlock x:Name="StateText" Grid.Column="1" Classes="queue-state classic-only" Text="{Binding StateText}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="CompactStateText" Grid.Column="1" Classes="queue-state modern-only" Text="{Binding CompactState}" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Button x:Name="ViewResultButton" Grid.Column="2" Content="查看任务详情" Classes="ac secondary" Click="ViewResultClick" IsVisible="False"/>
      </Grid>
      </Grid>
      </Grid>
      <Border Classes="classic-only"><TextBlock Classes="queue-secondary" Text="{Binding StateDetail}" IsVisible="{Binding HasStateDetail}" Height="18" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StateDetail}" FontSize="{DynamicResource UiFontCaption}"/></Border>
    </StackPanel>
  </Grid>
</UserControl>
