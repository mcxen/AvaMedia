<UserControl xmlns:ac="using:AvaMedia.Controls" xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.Controls.JobRowView">
  <UserControl.Styles>
    <!-- Drag affordances appear only on hover (UISPEC 7.4.2). -->
    <Style Selector="Border.cover-grip"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Grid.queue-row.can-drag:pointerover Border.cover-grip, Grid.queue-row.can-drag.show-grip Border.cover-grip"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Button.queue-cover-button"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="8,0,12,0"/></Style>
    <Style Selector="StackPanel.queue-details"><Setter Property="Margin" Value="8,2"/></Style>
    <Style Selector="TextBlock.queue-secondary"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>

    <Style Selector="TextBlock.queue-state"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="TextBlock.queue-state.running"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-state.awaitinguser"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-state.completed"><Setter Property="Foreground" Value="{DynamicResource UiSuccess}"/></Style>
    <Style Selector="TextBlock.queue-state.failed"><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>
    <Style Selector="TextBlock.queue-state.cancelled"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="TextBlock.queue-state.paused"><Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>
    <Style Selector="TextBlock.queue-stage"><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/></Style>
    <Style Selector="TextBlock.queue-stage.running"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-meta"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="ProgressBar.paused"><Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>
    <Style Selector="Window.windows-xp ListBoxItem:selected TextBlock.queue-secondary, Window.windows-xp ListBoxItem:selected TextBlock.queue-state, Window.windows-xp ListBoxItem:selected TextBlock.queue-stage, Window.windows-xp ListBoxItem:selected TextBlock.queue-meta"><Setter Property="Foreground" Value="White"/></Style>
  </UserControl.Styles>
  <Grid Classes="queue-row" x:Name="RowRoot" Background="Transparent" MinHeight="{DynamicResource ShellQueueRowHeight}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource UiQueuePreviewWidth}"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="{DynamicResource ShellQueueActionsWidth}"/></Grid.ColumnDefinitions>
    <Button x:Name="CoverButton" Classes="media-action queue-cover-button" VerticalAlignment="Center" Height="{DynamicResource UiQueueCoverHeight}" Click="CoverClick">
      <Border Classes="queue-artwork" ClipToBounds="True"><Grid Width="{DynamicResource UiQueueArtworkWidth}" Height="{DynamicResource UiQueueArtworkHeight}" ClipToBounds="True">
        <Border Background="{DynamicResource UiSurfaceRaised}"/>
        <Panel IsVisible="{Binding NoCover}">
          <local:FeatureIcon Classes="classic-only" Kind="{Binding Icon}" Label="{Binding PreviewExtension}" Width="{DynamicResource UiQueueIconWidth}" Height="{DynamicResource UiQueueIconHeight}"/>
          <local:LucideIcon Classes="modern-only queue-media-icon" Kind="{Binding MediaIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource UiTextSecondary}"/>
        </Panel>
        <Image x:Name="CoverImage" Classes="queue-cover" Source="{Binding Cover}" Stretch="Uniform"/>
        <Border x:Name="CoverDragGrip" Classes="cover-grip" Background="{DynamicResource UiMediaOverlay}" CornerRadius="4" Padding="2,3" Margin="0,0,3,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <local:LucideIcon Kind="grip-vertical" Width="12" Height="14" Foreground="{DynamicResource UiMediaText}"/>
        </Border>
      </Grid></Border>
    </Button>
    <StackPanel x:Name="InputDragHandle" Classes="queue-details" Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="queue-name" i18n:Localization.IsUserText="True" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.Source}"/>
        <TextBlock Grid.Column="1" Text="{Binding Job.SubmittedBy}" Classes="queue-secondary" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{Binding MetaLine}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary modern-only" ToolTip.Tip="{Binding FileSummary}"/>
      <StackPanel Classes="classic-only" ToolTip.Tip="{Binding FileSummary}">
        <TextBlock Text="{Binding MediaSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
        <TextBlock Text="{Binding CodecSummary}" IsVisible="{Binding HasCodecSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
        <TextBlock Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary non-platinum"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Classes="queue-details" Grid.Column="2" VerticalAlignment="Center">
      <Grid x:Name="OutputDragHandle" Background="Transparent">
        <TextBlock Classes="classic-only" i18n:Localization.IsUserText="True" Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.UserOutput}"/>
        <TextBlock Classes="modern-only queue-target" i18n:Localization.IsUserText="True" Text="{Binding TargetLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}"/>
      </Grid>
      <TextBlock Classes="classic-only queue-secondary" Text="{Binding SettingsSummary}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}" FontSize="{DynamicResource UiFontCaption}"/>
      <!-- Task status renders only from Job.StageSummary through TaskRowStatus (UISPEC 7.4.1). -->
      <StackPanel x:Name="StatusArea" Classes="queue-status" Spacing="3" Background="Transparent">
      <Grid x:Name="ProgressSlot" Classes="queue-progress" Height="{DynamicResource AcProgressHeight}">
        <ProgressBar Classes="ac" x:Name="PipelineProgress" Maximum="100" Height="{DynamicResource AcProgressHeight}" IsVisible="False"/>
        <ac:StageBar x:Name="StageBar" Classes="queue-stages" IsVisible="False"/>
      </Grid>
      <Grid Classes="queue-state-slot" x:Name="StateSlot" Height="28">
        <Grid x:Name="StateLine" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5">
          <ac:StatusPill x:Name="TaskStatePill" Classes="modern-only" VerticalAlignment="Center"/>
          <TextBlock x:Name="StateText" Classes="queue-state classic-only" MaxLines="1" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StageTitleText" Grid.Column="1" Classes="queue-stage" MaxLines="1" FontFeatures="tnum" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
          <TextBlock x:Name="CompactStateText" Grid.Column="2" Classes="queue-state" MaxLines="1" TextTrimming="CharacterEllipsis" FontFeatures="tnum" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StateMetaText" Grid.Column="3" Classes="queue-meta" MaxLines="1" FontFeatures="tnum" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource AcStatusGap}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
      <Button x:Name="RunTaskButton" Classes="ac secondary small" Click="RunTaskClick" ToolTip.Tip="开始任务" AutomationProperties.Name="开始任务"><local:LucideIcon x:Name="RunTaskIcon" Kind="play" Width="14" Height="14"/></Button>
      <Button x:Name="PauseTaskButton" Classes="ac secondary small" Click="PauseTaskClick" ToolTip.Tip="暂停" AutomationProperties.Name="暂停"><local:LucideIcon Kind="pause" Width="14" Height="14"/></Button>
      <Button x:Name="StopTaskButton" Classes="ac secondary small" Click="StopTaskClick" ToolTip.Tip="停止" AutomationProperties.Name="停止"><local:LucideIcon Kind="square" Width="14" Height="14"/></Button>
      <Button x:Name="ViewResultButton" Content="查看任务" Classes="ac secondary small" Click="ViewResultClick"/>
    </StackPanel>
    <!-- Hairline between rows, inset to start at the thumbnail's right edge (UISPEC 7.4). -->
    <Border Classes="queue-separator modern-only" Grid.ColumnSpan="4" Height="{DynamicResource ShellQueueSeparatorHeight}" Margin="{DynamicResource ShellQueueSeparatorInset}" VerticalAlignment="Bottom" Background="{DynamicResource ShellSeparator}" IsHitTestVisible="False"/>
  </Grid>
</UserControl>
