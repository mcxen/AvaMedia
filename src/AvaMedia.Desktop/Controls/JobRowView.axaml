<UserControl xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.Controls.JobRowView">
  <UserControl.Styles>
    <Style Selector="TextBlock.queue-state"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="TextBlock.queue-state.running"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-state.completed"><Setter Property="Foreground" Value="{DynamicResource UiSuccess}"/></Style>
    <Style Selector="TextBlock.queue-state.failed"><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>
    <Style Selector="TextBlock.queue-state.cancelled"><Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>
  </UserControl.Styles>
  <Grid x:Name="RowRoot" ColumnDefinitions="140,*,*" MinHeight="108" Margin="0,6">
    <Button x:Name="CoverButton" Classes="media-action" Padding="2" Margin="8,0,12,0" VerticalAlignment="Center" Height="80" Click="CoverClick" IsEnabled="{Binding CanPreview}" ToolTip.Tip="{Binding PreviewTip}" AutomationProperties.Name="{Binding PreviewTip}">
      <Grid Width="114" Height="72" ClipToBounds="True">
        <Border Background="{DynamicResource UiSurfaceRaised}"/>
        <local:FeatureIcon Kind="{Binding Icon}" Label="{Binding Extension}" Width="80" Height="64" IsVisible="{Binding NoCover}"/>
        <Image x:Name="CoverImage" Source="{Binding Cover}" Stretch="Uniform"/>
        <Border Background="{DynamicResource UiMediaOverlay}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasCover}">
          <TextBlock Text="▶" Foreground="{DynamicResource UiMediaText}" FontSize="12"/>
        </Border>
      </Grid>
    </Button>
    <StackPanel Grid.Column="1" Spacing="4" Margin="8,2" VerticalAlignment="Center" ToolTip.Tip="{Binding SourceTip}">
      <TextBlock i18n:Localization.IsUserText="True" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding MediaSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiTextSecondary}"/>
      <TextBlock Text="{Binding CodecSummary}" IsVisible="{Binding HasCodecSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiTextSecondary}"/>
      <TextBlock Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiTextSecondary}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="4" Margin="8,2" VerticalAlignment="Center">
      <TextBlock i18n:Localization.IsUserText="True" Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.Output}"/>
      <TextBlock Text="{Binding SettingsSummary}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiTextSecondary}"/>
      <ProgressBar Value="{Binding Job.Progress}" Maximum="100" Height="10"/>
      <TextBlock x:Name="StateText" Classes="queue-state" Text="{Binding StateText}" FontSize="{DynamicResource UiFontCaption}"/>
      <TextBlock Text="{Binding StateDetail}" IsVisible="{Binding HasStateDetail}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" ToolTip.Tip="{Binding StateDetail}" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiTextSecondary}"/>
    </StackPanel>
  </Grid>
</UserControl>
