<UserControl xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.Controls.JobRowView">
  <UserControl.Styles>
    <Style Selector="TextBlock.queue-secondary"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>

    <Style Selector="TextBlock.queue-state"><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
    <Style Selector="TextBlock.queue-state.running"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="TextBlock.queue-state.completed"><Setter Property="Foreground" Value="{DynamicResource UiSuccess}"/></Style>
    <Style Selector="TextBlock.queue-state.failed"><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>
    <Style Selector="TextBlock.queue-state.cancelled"><Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>
    <Style Selector="Window.windows-xp ListBoxItem:selected TextBlock.queue-secondary, Window.windows-xp ListBoxItem:selected TextBlock.queue-state"><Setter Property="Foreground" Value="White"/></Style>
  </UserControl.Styles>
  <Grid x:Name="RowRoot" MinHeight="{DynamicResource UiQueueRowHeight}" Margin="0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource UiQueuePreviewWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="CoverButton" Classes="media-action" Padding="2" Margin="8,0,12,0" VerticalAlignment="Center" Height="{DynamicResource UiQueueCoverHeight}" Click="CoverClick" ToolTip.Tip="{Binding PreviewTip}" AutomationProperties.Name="{Binding PreviewTip}">
      <Grid Width="{DynamicResource UiQueueArtworkWidth}" Height="{DynamicResource UiQueueArtworkHeight}" ClipToBounds="True">
        <Border Background="{DynamicResource UiSurfaceRaised}"/>
        <local:FeatureIcon Kind="{Binding Icon}" Label="{Binding Extension}" Width="{DynamicResource UiQueueIconWidth}" Height="{DynamicResource UiQueueIconHeight}" IsVisible="{Binding NoCover}"/>
        <Image x:Name="CoverImage" Source="{Binding Cover}" Stretch="Uniform"/>
        <Border Background="{DynamicResource UiMediaOverlay}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasCover}">
          <TextBlock Text="▶" Foreground="{DynamicResource UiMediaText}" FontSize="12"/>
        </Border>
      </Grid>
    </Button>
    <StackPanel Grid.Column="1" Spacing="4" Margin="8,2" VerticalAlignment="Center" ToolTip.Tip="{Binding SourceTip}">
      <TextBlock i18n:Localization.IsUserText="True" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding MediaSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
      <TextBlock Text="{Binding CodecSummary}" IsVisible="{Binding HasCodecSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
      <TextBlock Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="4" Margin="8,2" VerticalAlignment="Center">
      <Grid x:Name="OutputDragHandle" ColumnDefinitions="Auto,*" ColumnSpacing="4" Background="Transparent">
        <TextBlock x:Name="OutputDragGrip" Text="⋮⋮" Classes="queue-secondary" IsVisible="False" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" i18n:Localization.IsUserText="True" Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.Output}"/>
      </Grid>
      <TextBlock Text="{Binding SettingsSummary}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SettingsSummary}" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
      <Grid>
        <ProgressBar x:Name="PipelineProgress" Value="{Binding Job.Progress}" Maximum="100" Height="{DynamicResource UiQueueProgressHeight}"/>
        <local:AiActivityView x:Name="ActivityView" Compact="True"/>
      </Grid>
      <Grid x:Name="StateLine" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="StateText" Classes="queue-state" Text="{Binding StateText}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StateText}" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center"/>
        <Button x:Name="ViewResultButton" Grid.Column="1" Content="查看结果" Classes="tool" Click="ViewResultClick" IsVisible="False"/>
      </Grid>
      <TextBlock Text="{Binding StateDetail}" IsVisible="{Binding HasStateDetail}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StateDetail}" FontSize="{DynamicResource UiFontCaption}" Classes="queue-secondary"/>
    </StackPanel>
  </Grid>
</UserControl>
