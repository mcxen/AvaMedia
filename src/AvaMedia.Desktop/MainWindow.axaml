<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.MainWindow" Title="AvaMedia X64 1.0.2" Width="1440" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="25,55,*,26">
    <Menu Grid.Row="0" Background="{DynamicResource UiSurface}">
      <MenuItem Header="任务"><MenuItem Header="添加文件…" Click="AddClick"/><MenuItem Header="开始" Click="StartClick"/><MenuItem Header="停止" Click="StopClick"/><Separator/><MenuItem Header="保存任务列表…" Click="ExportQueueClick"/><MenuItem Header="载入任务列表…" Click="ImportQueueClick"/><Separator/><MenuItem Header="退出" Click="ExitClick"/></MenuItem>
      <MenuItem Header="皮肤"><MenuItem Header="经典浅色" Click="LightClick"/><MenuItem Header="深色" Click="DarkClick"/><MenuItem Header="Mac OS 9 · Platinum" Click="MacOS9Click"/></MenuItem>
      <MenuItem Header="语言"><MenuItem Header="简体中文" IsChecked="True" Click="ChineseClick"/></MenuItem>
      <MenuItem Header="选项" Click="SettingsClick"/>
      <MenuItem Header="批量"><MenuItem Header="视频批量裁剪…" Click="BatchCropClick"/><MenuItem Header="视频批量旋转…" Click="BatchRotateClick"/><MenuItem Header="视频重命名 / 多宫格截图…" Click="BatchToolsClick"/></MenuItem>
      <MenuItem Header="帮助"><MenuItem Header="功能与使用说明" Click="HelpClick"/><MenuItem Header="关于 / 开源许可证" Click="AboutClick"/></MenuItem>
    </Menu>
    <Border Grid.Row="1" BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,0,0,1" Background="{DynamicResource UiToolbar}">
      <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" Margin="7,0">
        <Button Classes="tool" Click="OutputClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="folder"/><TextBlock Text="输出文件夹" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Classes="tool" Click="SettingsClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="gear"/><TextBlock Text="选项" VerticalAlignment="Center"/></StackPanel></Button>
        <Border Background="{DynamicResource UiDivider}" Width="1" Height="38" Margin="5,0"/>
        <Button x:Name="RemoveButton" Classes="tool" Click="RemoveClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="remove" Classes="danger"/><TextBlock Text="移除" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="ClearButton" Classes="tool" Click="ClearClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="clear" Classes="danger"/><TextBlock Text="清空列表" VerticalAlignment="Center"/></StackPanel></Button>
        <Border Background="{DynamicResource UiDivider}" Width="1" Height="38" Margin="5,0"/>
        <Button x:Name="StopButton" Classes="tool" Click="StopClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="stop" Classes="danger"/><TextBlock Text="停止" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="StartButton" Classes="tool" Click="StartClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="play" Classes="success"/><TextBlock Text="开始" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="425,4,*">
      <Border Grid.Column="0" Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,1,0">
        <Grid x:Name="Categories">
          <ScrollViewer x:Name="FeatureScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="FeatureGrid" Margin="12" ColumnDefinitions="*,*,*,*"/>
          </ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="{DynamicResource UiDivider}" ResizeDirection="Columns"/>
      <Grid Grid.Column="2" RowDefinitions="25,*">
        <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Background="{DynamicResource UiSurfaceRaised}"><Grid ColumnDefinitions="140,*,*"><TextBlock Text="封面 / 预览" HorizontalAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1,0"><TextBlock Text="文件 / 媒体信息" HorizontalAlignment="Center"/></Border><TextBlock Grid.Column="2" Text="输出设置 / 任务状态" HorizontalAlignment="Center"/></Grid></Border>
        <ListBox Grid.Row="1" x:Name="JobList" Background="{DynamicResource UiSurface}" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource UiBorder}" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="JobDoubleClick" SelectionChanged="JobSelectionChanged">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
          <ListBox.ItemTemplate><DataTemplate><local:JobRowView/></DataTemplate></ListBox.ItemTemplate>
          <ListBox.ContextMenu><ContextMenu><MenuItem Header="播放 / 编辑" Click="EditSelectedClick"/><MenuItem Header="打开输出文件" Click="OpenSelectedClick"/><MenuItem Header="打开输出目录" Click="RevealClick"/><MenuItem Header="重试任务" Click="RetryClick"/><MenuItem Header="查看日志" Click="LogClick"/><MenuItem Header="移除任务" Click="RemoveClick"/></ContextMenu></ListBox.ContextMenu>
        </ListBox>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource UiStatusSurface}"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="5,0">
      <TextBlock x:Name="OutputPath" Foreground="{DynamicResource UiStatusText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <CheckBox x:Name="Multithread" Grid.Column="1" Foreground="{DynamicResource UiStatusText}" Content="使用多线程" IsChecked="True" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" MinHeight="20"/>
      <TextBlock x:Name="SummaryText" Grid.Column="2" Margin="16,0" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiStatusText}"/>
      <TextBlock x:Name="ElapsedText" Grid.Column="3" Foreground="{DynamicResource UiStatusText}" Text="耗时: 00:00:00" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" Margin="10,0"/>
      <CheckBox x:Name="Notify" Grid.Column="4" Foreground="{DynamicResource UiStatusText}" Content="完成通知" IsChecked="True" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" MinHeight="20"/>
    </Grid></Border>
  </Grid>
</Window>
