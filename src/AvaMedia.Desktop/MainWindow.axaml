<Window xmlns:i18n="using:AvaMedia.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" xmlns:notifications="using:AvaMedia.Desktop.Notifications" xmlns:core="using:AvaMedia.Core" x:Class="AvaMedia.Desktop.MainWindow" Title="{x:Static core:AppIdentity.WindowTitle}" Width="1440" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.tool-drop-indicator"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Button.tile.drop-target Border.tool-drop-indicator"><Setter Property="IsVisible" Value="True"/><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="Button.tile.drop-invalid Border.tool-drop-indicator"><Setter Property="IsVisible" Value="True"/><Setter Property="BorderBrush" Value="{DynamicResource UiDanger}"/></Style>
    <Style Selector="Button.notification-status"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu x:Name="ApplicationMenu" Grid.Row="{DynamicResource UiMainMenuRow}" Height="{DynamicResource UiMenuBarHeight}">
      <MenuItem Header="文件"><MenuItem Header="添加文件…" Click="AddClick"/><Separator/><MenuItem Header="保存任务列表…" Click="ExportQueueClick"/><MenuItem Header="载入任务列表…" Click="ImportQueueClick"/><Separator/><MenuItem Header="退出" Click="ExitClick"/></MenuItem>
      <MenuItem Header="WiFi 传文件" Click="WifiTransferClick"/>
      <MenuItem Header="编辑"><MenuItem x:Name="EditTaskMenuItem" Header="编辑任务…" Click="EditSelectedClick"/><Separator/><MenuItem x:Name="SettingsMenuItem" Header="偏好设置…" Click="SettingsClick"/></MenuItem>
      <MenuItem Header="显示">
        <MenuItem Header="通知中心…" Click="NotificationsClick"/>
        <Separator/>
        <MenuItem Header="皮肤"><MenuItem Header="经典浅色" Click="LightClick"/><MenuItem Header="深色" Click="DarkClick"/><MenuItem Header="Mac OS 9 · Platinum" Click="MacOS9Click"/><MenuItem Header="Windows XP · Luna" Click="WindowsXPClick"/></MenuItem>
        <MenuItem Header="语言"><MenuItem x:Name="SystemLanguageItem" Header="跟随系统" Click="SystemLanguageClick"/><Separator/><MenuItem x:Name="ChineseLanguageItem" Header="简体中文" Click="ChineseClick"/><MenuItem x:Name="EnglishLanguageItem" Header="English" Click="EnglishClick"/></MenuItem>
      </MenuItem>
      <MenuItem Header="转换"><MenuItem Header="开始" Click="StartClick"/><MenuItem Header="停止" Click="StopClick"/></MenuItem>
      <MenuItem Header="窗口"><MenuItem Header="缩放窗口" Click="ZoomWindowClick"/><MenuItem Header="收起 / 展开标题栏" IsEnabled="{DynamicResource UiWindowShadeEnabled}" Click="ShadeWindowClick"/><Separator/><MenuItem Header="最小化窗口" Click="MinimizeWindowClick"/></MenuItem>
      <MenuItem Header="帮助"><MenuItem Header="功能介绍" HotKey="F1" Click="HelpClick"/><MenuItem Header="关于 / 开源许可证" Click="AboutClick"/></MenuItem>
    </Menu>
    <Border Classes="app-toolbar" Grid.Row="{DynamicResource UiMainToolbarRow}" Height="{DynamicResource UiToolbarHeight}" BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,0,0,1" Background="{DynamicResource UiToolbar}">
      <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" Margin="{DynamicResource UiToolbarPadding}">
        <Button Classes="tool" Click="OutputClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="folder"/><TextBlock Text="输出文件夹" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Classes="tool" Click="SettingsClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="gear"/><TextBlock Text="选项" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Classes="tool" Click="WifiTransferClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="wifi"/><TextBlock Text="WiFi 传文件" VerticalAlignment="Center"/></StackPanel></Button>
        <Border Background="{DynamicResource UiDivider}" Width="1" Height="{DynamicResource UiToolbarSeparatorHeight}" Margin="5,0"/>
        <Button x:Name="EditTaskButton" Classes="tool" Click="EditSelectedClick" AutomationProperties.Name="编辑任务"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="edit"/><TextBlock Text="编辑" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="RemoveButton" Classes="tool" Click="RemoveClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="remove" Classes="danger"/><TextBlock Text="移除" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="ClearButton" Classes="tool" Click="ClearClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="clear" Classes="danger"/><TextBlock Text="清空列表" VerticalAlignment="Center"/></StackPanel></Button>
        <Border Background="{DynamicResource UiDivider}" Width="1" Height="{DynamicResource UiToolbarSeparatorHeight}" Margin="5,0"/>
        <Button x:Name="StopButton" Classes="tool" Click="StopClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="stop" Classes="danger"/><TextBlock Text="停止" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="StartButton" Classes="tool" Click="StartClick"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource UiSpacingSmall}"><local:ActionIcon Kind="play" Classes="success"/><TextBlock Text="开始" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource UiSidebarWidth}" MinWidth="{DynamicResource UiSidebarMinWidth}"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Classes="feature-sidebar" Grid.Column="0" Background="{DynamicResource UiFeaturePanel}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,1,0">
        <Grid x:Name="Categories">
          <ScrollViewer x:Name="FeatureScroll" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="FeatureGrid" Margin="12" ColumnDefinitions="*,*,*,*"/>
          </ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="{DynamicResource UiDivider}" ResizeDirection="Columns"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border Classes="platinum-list-heading" Height="{DynamicResource UiTableHeaderHeight}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Background="{DynamicResource UiSurfaceRaised}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource UiQueuePreviewWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="封面 / 预览" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
            <Border Grid.Column="1" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1,0">
              <TextBlock Text="文件 / 媒体信息" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
            </Border>
            <TextBlock Grid.Column="2" Text="输出设置 / 任务状态" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
          </Grid>
        </Border>
        <ListBox Grid.Row="1" x:Name="JobList" Padding="0" Background="{DynamicResource UiSurface}" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource UiBorder}" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="JobDoubleClick" SelectionChanged="JobSelectionChanged">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.Styles>
          <ListBox.ItemTemplate><DataTemplate><local:JobRowView/></DataTemplate></ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu Opening="JobContextMenuOpening">
              <MenuItem x:Name="ViewSummaryResultMenu" Header="查看视频总结结果…" Click="ViewSummaryResultClick" IsEnabled="False"/>
              <MenuItem x:Name="PlayOutputMenu" Header="用天池播放器播放输出视频" Click="PlayOutputSelectedClick" IsEnabled="False" ToolTip.Tip="任务完成且输出视频存在时可播放。支持多选。">
                <MenuItem.Icon><local:ActionIcon Kind="play"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="EditTaskContextMenu" Header="编辑任务…" Click="EditSelectedClick"/>
              <Separator/>
              <MenuItem Header="打开输出文件" Click="OpenSelectedClick"/>
              <MenuItem Header="打开输出目录" Click="RevealClick"/>
              <Separator/>
              <MenuItem x:Name="RetryTaskMenu" Header="重试任务" Click="RetryClick"/>
              <MenuItem Header="查看日志" Click="LogClick"/>
              <MenuItem Header="移除任务" Click="RemoveClick"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
        <local:DownloadSpeedMonitor x:Name="NetworkMonitor" Grid.Row="2" HorizontalAlignment="Right" Margin="8,6,8,6"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="3">
    <Border Classes="app-statusbar" Height="{DynamicResource UiStatusBarHeight}" Background="{DynamicResource UiStatusSurface}"><Grid ColumnDefinitions="2*,Auto,*,Auto,Auto,Auto,Auto" Margin="{DynamicResource UiStatusPadding}">
      <Grid ColumnDefinitions="Auto,*">
        <local:ActionIcon Kind="folder" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" IsVisible="{DynamicResource UiShowOutputIcon}"/>
        <TextBlock Grid.Column="1" i18n:Localization.IsUserText="True" x:Name="OutputPath" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource UiStatusText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      </Grid>
      <CheckBox x:Name="Multithread" Grid.Column="1" Foreground="{DynamicResource UiStatusText}" Content="使用多线程" IsChecked="True" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" MinHeight="20"/>
      <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" Grid.Column="2" Margin="16,0" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" Foreground="{DynamicResource UiStatusText}"/>
      <TextBlock x:Name="ElapsedText" Grid.Column="3" Foreground="{DynamicResource UiStatusText}" Text="耗时: 00:00:00" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" Margin="10,0"/>
      <CheckBox x:Name="Notify" Grid.Column="4" Foreground="{DynamicResource UiStatusText}" Content="完成通知" ToolTip.Tip="任务完成后在主界面右下角显示通知。" IsChecked="True" VerticalAlignment="Center" FontSize="{DynamicResource UiFontCaption}" MinHeight="20"/>
      <TextBlock x:Name="ResourceUsageText" Grid.Column="5" Text="CPU —   GPU —" i18n:Localization.IsUserText="True" ToolTip.Tip="整机 CPU、GPU 占用率" Foreground="{DynamicResource UiStatusText}" FontWeight="Normal" FontSize="{DynamicResource UiFontCaption}" VerticalAlignment="Center" Margin="16,0,4,0"/>
      <Border Grid.Column="6" BorderBrush="{DynamicResource UiDivider}" BorderThickness="1,0,0,0" Margin="4,0,0,0">
        <Button x:Name="NotificationButton" Classes="notification-status" Click="ToggleNotificationsClick" ToolTip.Tip="通知中心" AutomationProperties.Name="通知中心" VerticalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="通知" Foreground="{DynamicResource UiStatusText}" FontSize="{DynamicResource UiFontCaption}"/>
            <TextBlock x:Name="NotificationBadge" i18n:Localization.IsUserText="True" Foreground="{DynamicResource UiStatusText}" FontSize="{DynamicResource UiFontCaption}" IsVisible="False"/>
          </StackPanel>
        </Button>
      </Border>
    </Grid></Border>
    </StackPanel>
    <notifications:NotificationPanel Grid.Row="2" Width="364" MaxHeight="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"/>
  </Grid>
</Window>
