<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop.Controls" x:Class="AvaMedia.Desktop.EditorWindow" Classes="editor" Width="1400" Height="980" MinWidth="1000" MinHeight="730" WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="*,32,56,*,Auto">
    <Grid x:Name="PreviewArea" Background="Black" MinHeight="200">
      <Image x:Name="PreviewImage" Stretch="Uniform"/>
      <local:CropOverlay x:Name="CropLayer"/>
      <TextBlock x:Name="PreviewStatus" Text="正在读取媒体…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Slider Grid.Row="1" x:Name="SeekBar" Minimum="0" Maximum="1" Value="0" Margin="0,1"/>
    <Grid Grid.Row="2" ColumnDefinitions="232,*,232" VerticalAlignment="Center">
      <TextBlock x:Name="CurrentTime" Classes="time" Text="00:00:00.000"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button x:Name="BackwardButton" Classes="transport" Click="BackwardClick" ToolTip.Tip="按当前精度向前定位" AutomationProperties.Name="向前定位"><local:ActionIcon Kind="backward" Width="24" Height="24" Foreground="{DynamicResource UiAccent}"/></Button>
        <Button x:Name="PlayButton" Classes="transport" Click="PlayClick" ToolTip.Tip="播放" AutomationProperties.Name="播放"><local:ActionIcon x:Name="PlayIcon" Kind="play" Width="24" Height="24" Foreground="{DynamicResource UiAccent}"/></Button>
        <Button x:Name="StopButton" Classes="transport" Click="StopClick" ToolTip.Tip="停止" AutomationProperties.Name="停止"><local:ActionIcon Kind="stop" Width="24" Height="24" Foreground="{DynamicResource UiAccent}"/></Button>
        <Button x:Name="ForwardButton" Classes="transport" Click="ForwardClick" ToolTip.Tip="按当前精度向后定位" AutomationProperties.Name="向后定位"><local:ActionIcon Kind="forward" Width="24" Height="24" Foreground="{DynamicResource UiAccent}"/></Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="SoundButton" Classes="transport" Click="SoundClick" ToolTip.Tip="静音" AutomationProperties.Name="静音"><local:ActionIcon x:Name="SoundIcon" Kind="speaker" Width="24" Height="24" Foreground="{DynamicResource UiAccent}"/></Button>
        <TextBlock x:Name="TotalTime" Classes="time" Text="00:00:00.000"/>
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="3" x:Name="EditTabs" MinHeight="300" SelectionChanged="TabChanged">
      <TabItem Header="剪辑">
        <Grid RowDefinitions="28,32,32,*,32,Auto" ColumnDefinitions="*,*,264" RowSpacing="8" ColumnSpacing="24" Margin="12,12,12,0">
          <local:RangeBar x:Name="TrimBar" Grid.ColumnSpan="3"/>
          <Button x:Name="SetStartButton" Classes="field-action" Grid.Row="1" Content="开始时间" Click="SetStartClick" ToolTip.Tip="使用当前位置作为开始时间"/>
          <Button x:Name="SetEndButton" Classes="field-action" Grid.Row="1" Grid.Column="1" Content="结束时间" Click="SetEndClick" ToolTip.Tip="使用当前位置作为结束时间"/>
          <Grid Grid.Row="2" ColumnDefinitions="32,168,32" ColumnSpacing="8" HorizontalAlignment="Center">
            <Button x:Name="StartMinusButton" Classes="step" Click="StartMinus" ToolTip.Tip="减少开始时间" AutomationProperties.Name="减少开始时间"><local:ActionIcon Kind="minus" Width="16" Height="16" Foreground="{DynamicResource UiAccent}"/></Button>
            <TextBox x:Name="StartTime" Classes="time" Grid.Column="1" Text="00:00:00.000" LostFocus="TimeEdited" AutomationProperties.Name="开始时间"/>
            <Button x:Name="StartPlusButton" Classes="step" Grid.Column="2" Click="StartPlus" ToolTip.Tip="增加开始时间" AutomationProperties.Name="增加开始时间"><local:ActionIcon Kind="plus" Width="16" Height="16" Foreground="{DynamicResource UiAccent}"/></Button>
          </Grid>
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="32,168,32" ColumnSpacing="8" HorizontalAlignment="Center">
            <Button x:Name="EndMinusButton" Classes="step" Click="EndMinus" ToolTip.Tip="减少结束时间" AutomationProperties.Name="减少结束时间"><local:ActionIcon Kind="minus" Width="16" Height="16" Foreground="{DynamicResource UiAccent}"/></Button>
            <TextBox x:Name="EndTime" Classes="time" Grid.Column="1" Text="00:00:00.000" LostFocus="TimeEdited" AutomationProperties.Name="结束时间"/>
            <Button x:Name="EndPlusButton" Classes="step" Grid.Column="2" Click="EndPlus" ToolTip.Tip="增加结束时间" AutomationProperties.Name="增加结束时间"><local:ActionIcon Kind="plus" Width="16" Height="16" Foreground="{DynamicResource UiAccent}"/></Button>
          </Grid>
          <Border Grid.Row="3" Background="Black"><Image x:Name="StartImage" Stretch="Uniform"/></Border>
          <Border Grid.Row="3" Grid.Column="1" Background="Black"><Image x:Name="EndImage" Stretch="Uniform"/></Border>
          <Grid Grid.Row="4" ColumnDefinitions="*,168" ColumnSpacing="8"><TextBlock Text="淡入效果" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="FadeInCombo"/></Grid>
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,168" ColumnSpacing="8"><TextBlock Text="淡出效果" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="FadeOutCombo"/></Grid>
          <StackPanel Grid.Row="1" Grid.Column="2" Grid.RowSpan="4" Spacing="8">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="8" MinHeight="{StaticResource UiFieldHeight}"><TextBlock Text="持续时间" VerticalAlignment="Center"/><TextBlock x:Name="SelectionDuration" Classes="time" Grid.Column="1" HorizontalAlignment="Right"/></Grid>
            <Grid ColumnDefinitions="80,*" ColumnSpacing="8"><TextBlock Text="精度" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="PrecisionCombo"/></Grid>
            <Grid ColumnDefinitions="80,*" ColumnSpacing="8"><TextBlock Text="速度" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="SpeedCombo"/></Grid>

          </StackPanel>

        </Grid>
      </TabItem>
      <TabItem Header="画面裁剪">
        <StackPanel Spacing="16" Margin="28,25"><TextBlock Text="在上方画面拖动选择裁剪区域。坐标以源视频像素为单位。"/>
          <StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="X" VerticalAlignment="Center"/><TextBox x:Name="CropX" Width="100" Text="0"/><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox x:Name="CropY" Width="100" Text="0"/><TextBlock Text="宽度" VerticalAlignment="Center"/><TextBox x:Name="CropWidth" Width="100" Text="0"/><TextBlock Text="高度" VerticalAlignment="Center"/><TextBox x:Name="CropHeight" Width="100" Text="0"/></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="16"><Button Content="应用坐标" Click="ApplyCropClick"/><Button Content="重置选区" Click="ResetCropClick"/></StackPanel>
          <CheckBox x:Name="DelogoMode" Content="将选区用于去除水印" IsCheckedChanged="DelogoChanged"/>
          <TextBlock Text="使用模糊处理选区。" Foreground="{DynamicResource UiTextSecondary}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="选项">
        <StackPanel Spacing="18" Margin="28"><TextBlock x:Name="MediaDescription" TextWrapping="Wrap"/><Button Content="输出配置…" HorizontalAlignment="Left" Click="OptionsClick"/><TextBlock x:Name="AudioStatus" Text="预览音频正在准备…" Foreground="#666666"/><TextBlock Text="预览始终显示原媒体；剪辑、速度、裁剪与淡入淡出在输出时生效。"/></StackPanel>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="12,8">

      <Button Grid.Column="1" x:Name="EditorCancelButton" Classes="dialog-action" Content="取消" Click="CancelClick" IsCancel="True"/>
      <Button Grid.Column="2" x:Name="ConfirmButton" Classes="dialog-action" Content="确定" Click="ConfirmClick" IsDefault="True" />
    </Grid>
  </Grid>
</Window>
