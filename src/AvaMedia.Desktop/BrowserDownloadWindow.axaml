<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ac="using:AvaMedia.Controls"
        xmlns:i18n="using:AvaMedia.Desktop" x:Class="AvaMedia.Desktop.BrowserDownloadWindow"
        Title="浏览器嗅探" Width="1220" Height="800" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterOwner">
  <Grid Margin="{DynamicResource UiPagePadding}" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource AcRowGap}">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource AcRowGap}">
      <Button x:Name="BackButton" Content="后退" Click="BackClick" Classes="ac tool" IsEnabled="False"/>
      <Button Grid.Column="1" x:Name="ForwardButton" Content="前进" Click="ForwardClick" Classes="ac tool" IsEnabled="False"/>
      <Button Grid.Column="2" x:Name="ReloadButton" Content="刷新" Click="ReloadClick" Classes="ac tool"/>
      <TextBox Classes="ac" Grid.Column="3" x:Name="AddressInput" Watermark="网站地址" KeyDown="AddressKeyDown"/>
      <Button Grid.Column="4" x:Name="NavigateButton" Content="打开" Click="NavigateClick" Classes="ac tool"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="{DynamicResource AcRowGap}">
      <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="1">
        <Grid><ContentControl x:Name="BrowserHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <ac:EmptyState x:Name="BrowserUnavailable" Text="浏览器不可用" IsError="True" IsVisible="False"/></Grid>
      </Border>
      <Border Classes="ac-card" Grid.Column="1">
        <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource AcRowGap}">
          <Grid Margin="12,10" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource AcRowGap}">
            <TextBlock x:Name="MediaCount" Text="发现的视频" VerticalAlignment="Center"/>
            <CheckBox Classes="ac" Grid.Column="1" x:Name="SelectAll" Content="全选" IsCheckedChanged="SelectAllChanged"/>
          </Grid>
          <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="MediaList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Padding="12">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource AcRowGap}">
                        <CheckBox Classes="ac" IsChecked="{Binding IsChecked,Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock i18n:Localization.IsUserText="True" Text="{Binding Title}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"/>
                          <TextBlock i18n:Localization.IsUserText="True" Text="{Binding DisplayUrl}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayUrl}"/>
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPageLocation}">
                            <TextBlock i18n:Localization.IsUserText="True" Text="{Binding PageLocationLabel}" Classes="caption" VerticalAlignment="Center"/>
                            <Button Content="定位" Click="LocateMediaClick" Classes="ac tool"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ac:EmptyState x:Name="EmptyMedia" Text="尚未发现视频" Detail="播放视频后自动识别" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource AcGap}">
      <TextBlock x:Name="BrowserStatus" i18n:StableLayout.StatusLines="2" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="InstallRuntimeButton" Content="安装 WebView2" Click="InstallRuntimeClick" Classes="ac tool" IsVisible="False"/>
      <Button Grid.Column="2" Content="取消" Click="CancelClick" IsCancel="True" Classes="ac dialog-action"/>
      <Button Grid.Column="3" x:Name="UseMediaButton" Content="使用选中视频" Click="UseMediaClick" Classes="ac primary dialog-action" IsEnabled="False"/>
    </Grid>
  </Grid>
</Window>
