<Window xmlns="https://github.com/avaloniaui" xmlns:ac="using:AvaMedia.Controls" xmlns:local="using:AvaMedia.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AvaMedia.Desktop.SettingsWindow" Title="设置" Width="{DynamicResource StWindowWidth}" Height="{DynamicResource StWindowHeight}" MinWidth="{DynamicResource StWindowMinWidth}" MinHeight="{DynamicResource StWindowMinHeight}" Classes="settings" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://AvaMedia.Desktop/Styles/SettingsStyles.axaml"/>
  </Window.Styles>
  <Grid x:Name="SettingsRoot" RowDefinitions="*,Auto">
    <TabControl x:Name="SettingsTabs" Grid.RowSpan="2" Classes="settingsNavigation" TabStripPlacement="Left" SelectedIndex="0">
      <TabItem x:Name="GeneralTab" Header="通用">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <TextBlock Classes="settingsHeading" Text="输出"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="保存位置" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ac:SegmentedControl x:Name="OutputLocationInput">
                          <ListBoxItem Content="默认输出文件夹"/>
                          <ListBoxItem Content="源文件所在目录"/>
                        </ac:SegmentedControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow indented" x:Name="OutputFolderRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="默认输出文件夹" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <TextBox x:Name="OutputInput" Classes="ac" Width="{DynamicResource StOutputFieldWidth}" AutomationProperties.Name="输出文件夹"/>
                        <Button x:Name="OutputBrowseButton" Content="浏览…" Click="OutputBrowseClick" Classes="ac small"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="文件名附加格式或设置名称" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="例如 旅行_1080p.mp4" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="AddSettingNameInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="文件名附加格式或设置名称"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="任务完成后"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="显示完成通知" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="NotifyInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="显示完成通知"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="打开输出文件夹" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="OpenOutputInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="打开输出文件夹"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="全部成功后关闭电脑" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="仅在队列中所有任务成功时执行" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ShutdownInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="全部成功后关闭电脑"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="任务列表"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="折叠已完成任务" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="CollapseInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="折叠已完成任务"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="后台运行"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="关闭窗口时" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="任务会在后台继续进行" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ac:SegmentedControl x:Name="CloseBehaviorInput">
                          <ListBoxItem Content="退出应用"/>
                          <ListBoxItem Content="继续在托盘运行"/>
                        </ac:SegmentedControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="最小化时" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ac:SegmentedControl x:Name="MinimizeBehaviorInput">
                          <ListBoxItem Content="保留在程序坞"/>
                          <ListBoxItem Content="隐藏到托盘"/>
                        </ac:SegmentedControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="系统集成"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow" x:Name="ContextMenuRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="添加到系统上下文菜单" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="在文件管理器右键菜单中显示 AvaMedia" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ContextMenuInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="添加到系统上下文菜单"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow" x:Name="PlayerIntegrationRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="天池播放器" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button x:Name="RegisterPlayerButton" Content="注册天池播放器" Click="RegisterPlayerClick" Classes="ac small"/>
                        <Button x:Name="DefaultPlayerButton" Content="设为默认播放器" Click="DefaultPlayerClick" Classes="ac small"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="AppearanceTab" Header="外观与声音">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <TextBlock Classes="settingsHeading" Text="外观"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="界面皮肤" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="可选：跟随系统、浅色、深色、Mac OS 9、Windows XP" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ComboBox x:Name="ThemeInput" Width="{DynamicResource StThemeChoiceWidth}" Classes="ac">
                          <ComboBoxItem Content="跟随系统"/>
                          <ComboBoxItem Content="浅色"/>
                          <ComboBoxItem Content="深色"/>
                          <ComboBoxItem Content="Mac OS 9"/>
                          <ComboBoxItem Content="Windows XP"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border x:Name="LinuxScaleRow" Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="界面缩放" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="保存后重启生效；跟随系统使用桌面缩放。" TextWrapping="Wrap"/>
                      </StackPanel>
                      <ComboBox x:Name="LinuxScaleInput" Grid.Column="1" Width="{DynamicResource StThemeChoiceWidth}" Classes="ac" VerticalAlignment="Center">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="强调色" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <StackPanel x:Name="AccentPalette" Orientation="Horizontal" Spacing="{DynamicResource StSwatchGap}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="界面语言" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ac:SegmentedControl x:Name="LanguageInput">
                          <ListBoxItem Content="跟随系统"/>
                          <ListBoxItem Content="简体中文"/>
                          <ListBoxItem Content="English"/>
                        </ac:SegmentedControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="减少界面动效" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ReducedMotionInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="减少界面动效"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="音效"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="操作音效" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="OperationSoundInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="操作音效"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="完成音效" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="CompleteSoundInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="完成音效"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="错误音效" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ErrorSoundInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="错误音效"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="PlayerTab" Header="播放器">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <TextBlock Classes="settingsHeading" Text="播放"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="优先使用原生高分辨率播放" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="NativeHighResolutionInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="优先使用原生高分辨率播放"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="原生播放输出 SDR" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="在不支持 HDR 的显示器上避免画面发灰" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="NativeSdrInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="原生播放输出 SDR"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="文件操作"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="删除文件前确认" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ConfirmDeletionInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="删除文件前确认"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="ConversionTab" Header="转换与性能">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <TextBlock Classes="settingsHeading" Text="硬件加速"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动适配 GPU" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="GPU 优先，不可用时回退到 CPU" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="AutoGpuInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="自动适配 GPU"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GPU 能力" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button x:Name="HardwareTestButton" Content="查看 GPU 能力" Click="HardwareTestClick" Classes="ac small"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="CPU"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="每个任务的线程数" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="可选：自动、1（单线程）、2、4、8、12、16" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ComboBox x:Name="ThreadsInput" Width="{DynamicResource StChoiceWidth}" Classes="ac"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU 预留比例" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="0–80%，为系统和其他应用保留算力" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Slider x:Name="CpuReserveInput" Classes="ac" Width="{DynamicResource StSliderWidth}" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding #CpuReserveInput.Value, StringFormat={}{0:0}%}" Width="{DynamicResource StSliderValueWidth}" TextAlignment="Right" VerticalAlignment="Center" Classes="settingsDescription"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="默认图片质量"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JPEG 质量" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Slider x:Name="JpegQualityInput" Classes="ac" Width="{DynamicResource StSliderWidth}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding #JpegQualityInput.Value, StringFormat={}{0:0}}" Width="{DynamicResource StSliderValueWidth}" TextAlignment="Right" VerticalAlignment="Center" Classes="settingsDescription"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WebP 质量" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Slider x:Name="WebpQualityInput" Classes="ac" Width="{DynamicResource StSliderWidth}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding #WebpQualityInput.Value, StringFormat={}{0:0}}" Width="{DynamicResource StSliderValueWidth}" TextAlignment="Right" VerticalAlignment="Center" Classes="settingsDescription"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="ModelsTab" Header="本地模型">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <Border x:Name="ModelLifecycleSection"/>
              <TextBlock Classes="settingsHeading" Text="下载"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="模型下载源" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModelSourceHint" Classes="settingsDescription" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ComboBox x:Name="ModelSourceInput" Width="{DynamicResource StChoiceWidth}" Classes="ac"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow indented" x:Name="ModelSourceCustomRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自定义地址" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="选择“自定义”后可用" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <TextBox x:Name="ModelSourceUrlInput" Classes="ac" Width="{DynamicResource StAddressFieldWidth}" Watermark="兼容 Hugging Face 路径的镜像地址"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启动时自动下载图片修复模型" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="AutoRepairModelInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="启动时自动下载图片修复模型"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="标签与内容"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI 标签候选词" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button Content="管理词库…" Click="ManageWordLibraries" Classes="ac small"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启用 NSFW 分组与标签" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="NsfwContentInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="启用 NSFW 分组与标签"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="模型库"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="管理本地模型" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button x:Name="ModelLibraryButton" Content="查看模型库…" Classes="ac small" Click="ModelLibraryClick"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel x:Name="ModelLibraryPanel" IsVisible="False" Margin="{DynamicResource StLibraryMargin}">
                <ComboBox x:Name="ModelFilterInput" Classes="ac" Width="{DynamicResource StChoiceWidth}" HorizontalAlignment="Left">
                  <ComboBoxItem Content="全部模型"/>
                  <ComboBoxItem Content="已安装"/>
                  <ComboBoxItem Content="待下载"/>
                  <ComboBoxItem Content="下载中"/>
                  <ComboBoxItem Content="本地大模型"/>
                </ComboBox>
                <StackPanel x:Name="ModelList" Spacing="{DynamicResource StControlGap}" Margin="{DynamicResource StLibraryMargin}"/>
                <TextBlock x:Name="ModelStatus" Classes="settingError" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="ProvidersTab" Header="在线 AI">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <TextBlock Classes="settingsHeading" Text="供应商"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="默认供应商" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ComboBox x:Name="OnlineProviderInput" Classes="ac" Width="{DynamicResource StProviderFieldWidth}" local:Localization.IsUserText="True"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button x:Name="AddProviderButton" Content="添加供应商…" Click="AddProviderClick" Classes="ac small"/>
                        <Button x:Name="DeleteProviderButton" Content="删除" Click="DeleteProviderClick" Classes="ac small danger"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel x:Name="OnlineProviderSection">
                <TextBlock Classes="settingsHeading" Text="{Binding #OnlineNameInput.Text}" local:Localization.IsUserText="True" TextTrimming="CharacterEllipsis"/>
                <Border Classes="ac-group">
                  <StackPanel>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="启用" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <ToggleSwitch x:Name="OnlineEnabledInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="启用"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="名称" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="OnlineNameInput" Classes="ac" Width="{DynamicResource StAddressFieldWidth}" local:Localization.IsUserText="True"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="接口地址" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="OnlineEndpointInput" Classes="ac" Width="{DynamicResource StAddressFieldWidth}" local:Localization.IsUserText="True" Watermark="https://…/v1"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="API Key" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="OnlineKeyInput" Classes="ac" Width="{DynamicResource StShortFieldWidth}" PasswordChar="●" local:Localization.IsUserText="True"/>
                          <Button x:Name="RevealProviderKeyButton" Content="显示" Click="RevealProviderKeyClick" Classes="ac small"/>
                          <Button x:Name="ProviderSetupSection" Content="获取密钥" Click="ProviderApiKeyClick" Classes="ac small link" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
                <TextBlock Classes="settingsHeading" Text="模型"/>
                <Border Classes="ac-group">
                  <StackPanel>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="文本模型" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <AutoCompleteBox x:Name="OnlineTextModelInput" Classes="ac" Width="{DynamicResource StAddressFieldWidth}" MinimumPrefixLength="0" FilterMode="ContainsOrdinal" IsTextCompletionEnabled="False" local:Localization.IsUserText="True"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="视觉模型" TextWrapping="Wrap"/>
                          <TextBlock Classes="settingsDescription" Text="留空沿用文本模型" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <AutoCompleteBox x:Name="OnlineVisionModelInput" Classes="ac" Width="{DynamicResource StAddressFieldWidth}" MinimumPrefixLength="0" FilterMode="ContainsOrdinal" IsTextCompletionEnabled="False" local:Localization.IsUserText="True"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <Button x:Name="FetchProviderModelsButton" Content="连接并获取模型" Click="FetchProviderModelsClick" Classes="ac small primary"/>
                          <Button x:Name="CancelProviderModelsButton" Content="取消" Click="CancelProviderModelsClick" Classes="ac small" IsVisible="False"/>
                          <Button x:Name="ProviderDocsButton" Content="文档" Click="ProviderDocsClick" Classes="ac small link"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="ProviderStatus" Classes="settingsDescription" IsVisible="False" TextWrapping="Wrap"/>
                <TextBlock x:Name="OnlineLimitsText" Classes="settingsDescription" TextWrapping="Wrap" Margin="{DynamicResource StStatusMargin}"/>
                <TextBlock Classes="settingsHeading" Text="高级"/>
                <Border Classes="ac-group">
                  <StackPanel>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="输出长度参数" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <ac:SegmentedControl x:Name="OnlineTokenInput">
                            <ListBoxItem Content="max_tokens"/>
                            <ListBoxItem Content="max_completion_tokens"/>
                          </ac:SegmentedControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="结构化输出" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <ac:SegmentedControl x:Name="OnlineFormatInput">
                            <ListBoxItem Content="提示词约束"/>
                            <ListBoxItem Content="JSON 对象"/>
                            <ListBoxItem Content="严格 JSON Schema"/>
                          </ac:SegmentedControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="请求超时" TextWrapping="Wrap"/>
                          <TextBlock Classes="settingsDescription" Text="10–600 秒" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <NumericUpDown x:Name="OnlineTimeoutInput" Classes="ac" Minimum="10" Maximum="600" Increment="10" Width="{DynamicResource StCompactFieldWidth}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="RemoteTab" Header="远程管理">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <Border x:Name="McpSection"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="ToolsTab" Header="高级">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <StackPanel x:Name="ExternalToolPaths">
                <TextBlock Classes="settingsHeading" Text="外部工具"/>
                <Border Classes="ac-group">
                  <StackPanel>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="FFmpeg" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="FfmpegInput" Classes="ac" Width="{DynamicResource StLanguageFieldWidth}" Watermark="自动查找"/>
                          <Button Content="选取…" Click="FfmpegBrowseClick" Classes="ac small"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="FFprobe" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="FfprobeInput" Classes="ac" Width="{DynamicResource StLanguageFieldWidth}" Watermark="自动查找"/>
                          <Button Content="选取…" Click="FfprobeBrowseClick" Classes="ac small"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="ac-setting-row settingsRow">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="yt-dlp" TextWrapping="Wrap"/>
                          <TextBlock Classes="settingsDescription" Text="留空使用内置工具" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                          <TextBox x:Name="YtdlpInput" Classes="ac" Width="{DynamicResource StLanguageFieldWidth}" Watermark="自动查找"/>
                          <Button Content="选取…" Click="YtdlpBrowseClick" Classes="ac small"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Classes="settingsHeading" Text="实验功能"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开启 Beta 功能" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="BetaInput" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="开启 Beta 功能"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="运行信息"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <SelectableTextBlock x:Name="RuntimeInfo" Classes="settingsDescription" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
      <TabItem x:Name="AboutTab" Header="关于">
        <Border Classes="settingsPage">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{DynamicResource StNoGap}">
              <Border Classes="ac-group" Margin="{DynamicResource StSectionGap}">
                <StackPanel HorizontalAlignment="Center" Spacing="{DynamicResource StDetailGap}" Margin="{DynamicResource StAboutMargin}">
                  <Image x:Name="AboutAppIcon" Source="avares://AvaMedia.Desktop/Assets/AppIcon/v2/app.png" Width="{DynamicResource StAboutIconSize}" Height="{DynamicResource StAboutIconSize}"/>
                  <TextBlock Text="AvaMedia" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="VersionText" Classes="settingsDescription"/>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="软件更新"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="更新方式" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="可选：仅手动检查 / 启动时检查并提示 / 自动下载，退出时安装" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <ComboBox x:Name="UpdateModeInput" Width="{DynamicResource StLongFieldWidth}" Classes="ac">
                          <ComboBoxItem Content="仅手动检查"/>
                          <ComboBoxItem Content="启动时检查并提示"/>
                          <ComboBoxItem Content="自动下载，退出时安装"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border x:Name="UpdateStatusCard" Classes="ac-setting-row settingsRow">
                    <StackPanel Spacing="{DynamicResource StControlGap}">
                      <TextBlock x:Name="UpdateStatusTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock x:Name="UpdateMetadataText" Classes="settingsDescription" TextWrapping="Wrap"/>
                      <SelectableTextBlock x:Name="UpdateStatusMessage" TextWrapping="Wrap"/>
                      <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Classes="ac"
                                   Foreground="{DynamicResource UiAccent}" Background="{DynamicResource UiTrack}" IsVisible="False"/>
                      <TextBlock x:Name="LastUpdateCheckText" Classes="settingsDescription" TextWrapping="Wrap"/>
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CheckUpdatesButton" Content="立即检查" Click="CheckUpdatesClick" Classes="ac small" Margin="{DynamicResource StUpdateActionMargin}"/>
                        <Button x:Name="UpdateReleaseButton" Content="打开发布页" Click="UpdateReleaseClick" Classes="ac small" Margin="{DynamicResource StUpdateActionMargin}" IsVisible="False"/>
                        <Button x:Name="UpdateLogButton" Content="查看日志" Click="UpdateLogClick" Classes="ac small" Margin="{DynamicResource StUpdateActionMargin}" IsVisible="False"/>
                        <Button x:Name="UpdatePrimaryButton" Click="UpdatePrimaryClick" Classes="ac small primary" Margin="{DynamicResource StUpdateActionMargin}" IsVisible="False"/>
                      </WrapPanel>
                      <Expander x:Name="UpdateReleaseNotes" Header="更新说明" Classes="ac" IsExpanded="True" IsVisible="False">
                        <ScrollViewer MaxHeight="{DynamicResource StUpdateNotesHeight}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                          <ContentControl x:Name="UpdateReleaseNotesContent" Classes="release-notes" Padding="{DynamicResource StUpdateNotesPadding}" HorizontalContentAlignment="Stretch"/>
                        </ScrollViewer>
                      </Expander>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Classes="settingsHeading" Text="恢复默认"/>
              <Border Classes="ac-group">
                <StackPanel>
                  <Border Classes="ac-setting-row settingsRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource StPropertyGap}">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="恢复默认设置" TextWrapping="Wrap"/>
                        <TextBlock Classes="settingsDescription" Text="仅重置本窗口中的设置" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource StControlGap}" VerticalAlignment="Center">
                        <Button x:Name="DefaultButton" Content="恢复默认…" Click="ResetClick" Classes="ac small danger"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource StControlGap}" Margin="{DynamicResource StFooterMargin}">
      <TextBlock x:Name="StatusText" Classes="settingError" IsVisible="False" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="CancelButton" Classes="ac settingsFooter" Content="取消" Click="CancelClick" IsCancel="True"/>
      <Button Grid.Column="2" x:Name="ApplyButton" Classes="ac settingsFooter" Content="应用" Click="ApplyClick" IsEnabled="False"/>
      <Button Grid.Column="3" x:Name="OkButton" Classes="ac primary settingsFooter" Content="确定" Click="OkClick" IsDefault="True"/>
    </Grid>
  </Grid>
</Window>
