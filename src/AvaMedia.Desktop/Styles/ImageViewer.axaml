<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Floats use the active theme's surfaces and type, not a separate dark glass. -->
  <Style Selector="Border.viewer-chrome">
    <Setter Property="Background" Value="{DynamicResource UiToolbar}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/>
    <Setter Property="Padding" Value="6,4,4,4"/>
    <Setter Property="Opacity" Value="0.94"/>
  </Style>
  <Style Selector="Border.viewer-chrome Button.viewer-tool">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style Selector="Border.viewer-chrome Button.viewer-tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiHover}"/>
  </Style>
  <Style Selector="Border.viewer-chrome Button.viewer-tool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiPressed}"/>
  </Style>
  <Style Selector="Border.viewer-chrome ComboBox.viewer-fit">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="8,2"/>
  </Style>
  <Style Selector="Border.viewer-chrome Border.viewer-divider">
    <Setter Property="Background" Value="{DynamicResource UiDivider}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="TextBlock.viewer-zoom">
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
    <Setter Property="Background" Value="{DynamicResource UiToolbar}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="Opacity" Value="0.94"/>
  </Style>
  <Style Selector="Border.viewer-info">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Opacity" Value="0.92"/>
  </Style>
  <Style Selector="TextBlock.viewer-summary">
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiFontCaption}"/>
  </Style>
  <Style Selector="TextBlock.viewer-meta">
    <Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiFontCaption}"/>
  </Style>
  <Style Selector="Border.viewer-info Button.viewer-map">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="10,2"/>
  </Style>
  <Style Selector="Border.viewer-library">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
</Styles>
