<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Thickness x:Key="RenameWindowPadding">18</Thickness>
    <x:Double x:Key="RenameRulesWidth">320</x:Double>
    <x:Double x:Key="RenameSortWidth">180</x:Double>
    <x:Double x:Key="RenameRuleListMinHeight">120</x:Double>
    <x:Double x:Key="RenameRuleListMaxHeight">180</x:Double>
    <GridLength x:Key="RenameCheckWidth">28</GridLength>
    <GridLength x:Key="RenameKindWidth">55</GridLength>
    <GridLength x:Key="RenameStatusWidth">120</GridLength>
    <Thickness x:Key="RenameHairlineThickness">0,0,0,0.5</Thickness>
    <Thickness x:Key="RenameRuleOptionMargin">0,0,4,4</Thickness>
    <Thickness x:Key="RenameMenuHeaderMargin">0,0,16,0</Thickness>
  </Styles.Resources>
  <Style Selector="Window.rename-tool Grid.rename-file-header">
    <Setter Property="MinHeight" Value="{DynamicResource UiTableHeaderHeight}"/>
    <Setter Property="Margin" Value="{DynamicResource AcListPadding}"/>
  </Style>
  <Style Selector="Window.rename-tool Border.rename-file-row">
    <Setter Property="Height" Value="NaN"/>
    <Setter Property="MinHeight" Value="{DynamicResource AcTextRowHeight}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="{DynamicResource RenameHairlineThickness}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AcHairline}"/>
  </Style>
  <Style Selector="Window.rename-tool WrapPanel.rename-rule-options Button">
    <Setter Property="Margin" Value="{DynamicResource RenameRuleOptionMargin}"/>
  </Style>
</Styles>
