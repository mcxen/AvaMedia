<!-- Quick-clip editor layout (EditorWindow QuickRoot), see editor/clip-editor-demo.html and UISPEC.MD. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop" xmlns:controls="using:AvaMedia.Desktop.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="QcCanvas" Color="#F5F5F7"/><SolidColorBrush x:Key="QcChrome" Color="#FBFBFD"/><SolidColorBrush x:Key="QcCard" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="QcLine" Color="#E5E5EA"/><SolidColorBrush x:Key="QcRowLine" Color="#F0F0F2"/><SolidColorBrush x:Key="QcText" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="QcSecondary" Color="#86868B"/><SolidColorBrush x:Key="QcValue" Color="#6E6E73"/><SolidColorBrush x:Key="QcIcon" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="QcAccent" Color="#007AFF"/><SolidColorBrush x:Key="QcAccentText" Color="#FFFFFF"/><SolidColorBrush x:Key="QcSegTrack" Color="#E9E9EE"/>
          <SolidColorBrush x:Key="QcSegOn" Color="#FFFFFF"/><SolidColorBrush x:Key="QcRowSelected" Color="#0F007AFF"/><SolidColorBrush x:Key="QcChip" Color="#F2F2F7"/>
          <SolidColorBrush x:Key="QcBarIdle" Color="#D1D1D6"/><SolidColorBrush x:Key="QcHover" Color="#0D000000"/><SolidColorBrush x:Key="QcPreview" Color="#0C0C0E"/>
          <SolidColorBrush x:Key="QcStrip" Color="#E5E5EA"/><SolidColorBrush x:Key="QcPillLine" Color="#24000000"/><SolidColorBrush x:Key="QcPlayhead" Color="#FF3B30"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="QcCanvas" Color="#1C1C1E"/><SolidColorBrush x:Key="QcChrome" Color="#232325"/><SolidColorBrush x:Key="QcCard" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="QcLine" Color="#26FFFFFF"/><SolidColorBrush x:Key="QcRowLine" Color="#3A3A3C"/><SolidColorBrush x:Key="QcText" Color="#F5F5F7"/>
          <SolidColorBrush x:Key="QcSecondary" Color="#98989D"/><SolidColorBrush x:Key="QcValue" Color="#AEAEB2"/><SolidColorBrush x:Key="QcIcon" Color="#D1D1D6"/>
          <SolidColorBrush x:Key="QcAccent" Color="#0A84FF"/><SolidColorBrush x:Key="QcAccentText" Color="#FFFFFF"/><SolidColorBrush x:Key="QcSegTrack" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="QcSegOn" Color="#636366"/><SolidColorBrush x:Key="QcRowSelected" Color="#260A84FF"/><SolidColorBrush x:Key="QcChip" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="QcBarIdle" Color="#48484A"/><SolidColorBrush x:Key="QcHover" Color="#14FFFFFF"/><SolidColorBrush x:Key="QcPreview" Color="#000000"/>
          <SolidColorBrush x:Key="QcStrip" Color="#3A3A3C"/><SolidColorBrush x:Key="QcPillLine" Color="#33FFFFFF"/><SolidColorBrush x:Key="QcPlayhead" Color="#FF453A"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:Skin.MacOS9}">
          <SolidColorBrush x:Key="QcCanvas" Color="#CCCCCC"/><SolidColorBrush x:Key="QcChrome" Color="#DDDDDD"/><SolidColorBrush x:Key="QcCard" Color="#EEEEEE"/>
          <SolidColorBrush x:Key="QcLine" Color="#777777"/><SolidColorBrush x:Key="QcRowLine" Color="#BBBBBB"/><SolidColorBrush x:Key="QcText" Color="#111111"/>
          <SolidColorBrush x:Key="QcSecondary" Color="#555555"/><SolidColorBrush x:Key="QcValue" Color="#333333"/><SolidColorBrush x:Key="QcIcon" Color="#111111"/>
          <SolidColorBrush x:Key="QcAccent" Color="#3D4E80"/><SolidColorBrush x:Key="QcAccentText" Color="#111111"/><SolidColorBrush x:Key="QcSegTrack" Color="#BBBBBB"/>
          <SolidColorBrush x:Key="QcSegOn" Color="#FFFFFF"/><SolidColorBrush x:Key="QcRowSelected" Color="#C7CDE0"/><SolidColorBrush x:Key="QcChip" Color="#DDDDDD"/>
          <SolidColorBrush x:Key="QcBarIdle" Color="#999999"/><SolidColorBrush x:Key="QcHover" Color="#22000000"/><SolidColorBrush x:Key="QcPreview" Color="#000000"/>
          <SolidColorBrush x:Key="QcStrip" Color="#BBBBBB"/><SolidColorBrush x:Key="QcPillLine" Color="#777777"/><SolidColorBrush x:Key="QcPlayhead" Color="#CC0000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window.message-dialog"><Setter Property="Background" Value="{DynamicResource QcCanvas}"/><Setter Property="Foreground" Value="{DynamicResource QcText}"/></Style>
  <Style Selector="Window.message-dialog TextBlock"><Setter Property="FontSize" Value="{DynamicResource AcBodyFont}"/><Setter Property="Foreground" Value="{DynamicResource QcText}"/></Style>
  <Style Selector="Window.message-dialog TextBlock.heading"><Setter Property="FontSize" Value="17"/></Style>

  <Style Selector="Window.editor Grid#QuickRoot"><Setter Property="Background" Value="{DynamicResource QcCanvas}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot TextBlock"><Setter Property="Foreground" Value="{DynamicResource QcText}"/><Setter Property="FontSize" Value="{DynamicResource AcBodyFont}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot TextBlock.sec"><Setter Property="Foreground" Value="{DynamicResource QcSecondary}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot TextBlock.value"><Setter Property="Foreground" Value="{DynamicResource QcValue}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot TextBlock.mono"><Setter Property="FontFeatures" Value="tnum"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot TextBlock.head"><Setter Property="FontSize" Value="{DynamicResource AcCaptionFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource QcSecondary}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot controls|LucideIcon"><Setter Property="Foreground" Value="{DynamicResource QcIcon}"/><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/></Style>

  <Style Selector="Window.editor Grid#QuickRoot Border.qc-chrome"><Setter Property="Background" Value="{DynamicResource QcChrome}"/><Setter Property="BorderBrush" Value="{DynamicResource QcLine}"/></Style>

  <!-- Buttons: flat icon buttons, white pills, the round play button and the blue primary. -->

  <Style Selector="Window.editor Grid#QuickRoot Button.frame"><Setter Property="Padding" Value="0"/><Setter Property="Height" Value="75"/><Setter Property="CornerRadius" Value="{DynamicResource AcListRadius}"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource QcPreview}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot Button.frame:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource QcPreview}"/></Style>

  <!-- Title bar segmented control (ModeButtons are built by EditorWindow.Modes.cs). -->

  <!-- Flat inputs: combos in the property list and the precision pill, time boxes in the frame cards. -->

  <!-- Segment list rows. -->
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource QcRowSelected}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource QcHover}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource QcText}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected TextBlock.sec"><Setter Property="Foreground" Value="{DynamicResource QcSecondary}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected TextBlock.value"><Setter Property="Foreground" Value="{DynamicResource QcValue}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot Border.qc-bar"><Setter Property="Background" Value="{DynamicResource QcBarIdle}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected Border.qc-bar"><Setter Property="Background" Value="{DynamicResource QcAccent}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot ListBox#SegmentList ListBoxItem:selected TextBlock.name"><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot Border.tag"><Setter Property="Background" Value="{DynamicResource QcAccent}"/><Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/><Setter Property="Padding" Value="6,1"/><Setter Property="Margin" Value="5"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot Border.tag TextBlock"><Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

  <!-- Template-level pill chrome: app-wide editor button styles would otherwise flatten the border. -->

  <Style Selector="Window.editor Grid#QuickRoot Border#QuickPrecisionPill"><Setter Property="BorderBrush" Value="{DynamicResource QcPillLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="{DynamicResource AcButtonShadow}"/></Style>

  <!-- SimpleTheme uses different named parts from Fluent. Keep the actual ComboBox and its popup/keyboard behavior. -->

  <Style Selector="Window.mac-os9 Grid#QuickRoot Button.frame"><Setter Property="BorderThickness" Value="0"/></Style>

  <Style Selector="FlyoutPresenter.quick-info">
    <Setter Property="Background" Value="{DynamicResource QcCard}"/><Setter Property="Foreground" Value="{DynamicResource QcText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource QcPillLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource UiCardRadius}"/><Setter Property="Padding" Value="14"/>
  </Style>
  <Style Selector="FlyoutPresenter.quick-info TextBlock"><Setter Property="Foreground" Value="{DynamicResource QcText}"/><Setter Property="FontSize" Value="{DynamicResource AcBodyFont}"/></Style>
  <Style Selector="FlyoutPresenter.quick-info TextBlock.sec"><Setter Property="Foreground" Value="{DynamicResource QcSecondary}"/></Style>

  <!-- Quick mode cards keep the original editing controls and share the surrounding quick layout. -->

  <Style Selector="Window.editor Grid#QuickRoot Border.audio-dot"><Setter Property="Background" Value="{DynamicResource QcSecondary}"/></Style>
  <Style Selector="Window.editor Grid#QuickRoot Border.audio-dot.ready"><Setter Property="Background" Value="{DynamicResource UiSuccessFill}"/></Style>

</Styles>
