<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Editor layout uses the shared role metrics; every value can be overridden by a skin. -->

  <Style Selector="Window.editor TextBlock.time">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiTimeFontSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Window.editor Button.boundary-preview">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource UiMediaSurface}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="84"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments ListBoxItem">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Redesigned quick editor: segmented modes, frame cards (skin-neutral resources). -->
  <!-- Modes are presented by SegmentedControl; this container only owns the active page.
       Do not instantiate hidden header controls while a skin reparents the window body. -->
  <Style Selector="Window.editor TabControl.mode-tabs"><Setter Property="Template"><ControlTemplate><DockPanel><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" IsVisible="False"/><ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></DockPanel></ControlTemplate></Setter></Style>

  <Style Selector="Window.editor Border.frame-badge">
    <Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="CornerRadius" Value="{DynamicResource UiArtworkRadius}"/><Setter Property="Padding" Value="6,1"/>
    <Setter Property="Margin" Value="5"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="Window.editor Border.frame-badge.end"><Setter Property="Background" Value="{DynamicResource UiWarning}"/></Style>
  <Style Selector="Window.editor Border.frame-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Window.editor Border.inspector">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments Border.segment-accent">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments ListBoxItem:selected Border.segment-accent">
    <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
  </Style>
  <Style Selector="Window.editor Grid.export-bar">
    <Setter Property="MinHeight" Value="44"/>
  </Style>
</Styles>
