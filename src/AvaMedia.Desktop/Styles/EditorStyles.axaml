<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Editor layout uses the shared role metrics; every value can be overridden by a skin. -->
  <Style Selector="Window.editor TextBox, Window.editor ComboBox, Window.editor Button:not(.platinum-caption):not(.dialog-action)">
    <Setter Property="MinHeight" Value="{DynamicResource UiFieldHeight}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiFontBody}"/>
  </Style>
  <Style Selector="Window.editor TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor ComboBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor Button">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor TextBox, Window.editor ComboBox, Window.editor Button.field-action">
    <Setter Property="Height" Value="{DynamicResource UiFieldHeight}"/>
  </Style>
  <Style Selector="Window.editor TextBlock.time">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiTimeFontSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor TextBox.time">
    <Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiTimeFontSize}"/>
    <Setter Property="Width" Value="{DynamicResource UiTimeFieldWidth}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Padding" Value="{DynamicResource UiInputPadding}"/>
  </Style>
  <Style Selector="Window.editor Button.step">
    <Setter Property="Width" Value="{DynamicResource UiFieldHeight}"/>
    <Setter Property="Height" Value="{DynamicResource UiFieldHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource UiCompactButtonPadding}"/>
  </Style>
  <Style Selector="Window.editor Button.transport">
    <Setter Property="Width" Value="{DynamicResource UiTransportSize}"/>
    <Setter Property="Height" Value="{DynamicResource UiTransportSize}"/>
    <Setter Property="Padding" Value="{DynamicResource UiCompactButtonPadding}"/>
  </Style>
  <Style Selector="Window.editor Button.boundary-preview">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource UiMediaSurface}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="84"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Window.editor ListBox.clip-segments ListBoxItem">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Window.editor Button.segment-play">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <!-- Redesigned quick editor: segmented modes, frame cards, keycaps (skin-neutral resources). -->
  <Style Selector="Window.editor TabControl.mode-tabs /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.editor Border.mode-switch">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceRaised}"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Window.editor Button.mode">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="14,4"/><Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style Selector="Window.editor Button.mode.active">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Window.editor Border.frame-card">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Window.editor Border.frame-badge">
    <Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,1"/>
    <Setter Property="Margin" Value="5"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="Window.editor Border.frame-badge.end"><Setter Property="Background" Value="{DynamicResource UiWarning}"/></Style>
  <Style Selector="Window.editor Border.frame-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Window.editor Border.keycap">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor Border.keycap TextBlock"><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="Window.editor WrapPanel.key-hints > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/><Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Margin" Value="4,0,12,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Window.editor Border.editor-card">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8,10,6"/>
  </Style>
</Styles>
