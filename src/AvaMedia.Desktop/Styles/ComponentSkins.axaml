<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop"><Styles.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="{x:Static local:Skin.MacOS9}">
<x:Boolean x:Key="AcMaterialEnabled">False</x:Boolean>
<BoxShadows x:Key="AcPopupShadow">none</BoxShadows>
<CornerRadius x:Key="AcCardRadius">0</CornerRadius>
<CornerRadius x:Key="AcSheetRadius">0</CornerRadius>
<CornerRadius x:Key="AcStatusRadius">0</CornerRadius>
<CornerRadius x:Key="AcThumbRadius">0</CornerRadius>
<CornerRadius x:Key="AcCheckRadius">0</CornerRadius>
<CornerRadius x:Key="AcSegmentRadius">0</CornerRadius>
<CornerRadius x:Key="AcSegmentItemRadius">0</CornerRadius>
<CornerRadius x:Key="AcColorBarRadius">0</CornerRadius>
<CornerRadius x:Key="AcPreviewRadius">0</CornerRadius>
<CornerRadius x:Key="AcListRadius">0</CornerRadius>
<CornerRadius x:Key="AcGroupRadius">0</CornerRadius>
<SolidColorBrush x:Key="AcCardFace" Color="#FFFFFF"/>
<SolidColorBrush x:Key="AcSheetFace" Color="#FFFFFF"/>
<SolidColorBrush x:Key="AcSegmentFace" Color="#FFFFFF"/>
<SolidColorBrush x:Key="AcWarningText" Color="#795314"/>
<BoxShadows x:Key="AcCardShadow">none</BoxShadows>
<BoxShadows x:Key="AcChipShadow">none</BoxShadows>
<BoxShadows x:Key="AcSegmentShadow">none</BoxShadows>
<BoxShadows x:Key="AcKnobShadow">none</BoxShadows>
<SolidColorBrush x:Key="AcRunningFill" Color="#DDE2EE"/>
<SolidColorBrush x:Key="AcSuccessFill" Color="#E5EBDD"/>
<SolidColorBrush x:Key="AcWarningFill" Color="#F3E9D0"/>
<SolidColorBrush x:Key="AcDangerFill" Color="#F1DADA"/>
<SolidColorBrush x:Key="AcWaitingFill" Color="#E3E3E3"/>
<SolidColorBrush x:Key="AcPreviewFill" Color="#D8D8D8"/>
<SolidColorBrush x:Key="UiSpeechStepSurface" Color="#CCCCCC"/>
</ResourceDictionary>
<ResourceDictionary x:Key="{x:Static local:Skin.WindowsXP}">
<x:Boolean x:Key="AcMaterialEnabled">False</x:Boolean>
<BoxShadows x:Key="AcPopupShadow">none</BoxShadows>
<CornerRadius x:Key="AcCardRadius">3</CornerRadius>
<CornerRadius x:Key="AcSheetRadius">3</CornerRadius>
