<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="using:AvaMedia.Controls" xmlns:local="using:AvaMedia.Desktop">
  <Styles.Resources><local:OptionsTabHeadersConverter x:Key="OptionsTabHeaders"/></Styles.Resources>
  <Style Selector="TabControl.mediaOptionsNavigation">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource AcGap}">
          <!-- TabControl needs its presenter to resolve the selected page's container. -->
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                          Height="0" Opacity="0" IsHitTestVisible="False"/>
          <ac:SegmentedControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OptionsTabHeaders}}"
                               SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               HorizontalAlignment="Left">
          </ac:SegmentedControl>
          <ContentPresenter Grid.Row="1" Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
