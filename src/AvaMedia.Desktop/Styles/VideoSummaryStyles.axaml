<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <x:Double x:Key="UiSummaryFontSize">13</x:Double>
    <x:Double x:Key="UiSummaryLineHeight">20</x:Double>
    <x:Double x:Key="UiSummaryTitleSize">15</x:Double>
  </Styles.Resources>
  <Style Selector="Window.video-summary-result Border.summary-toolbar">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Window.video-summary-result Border.summary-card">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style Selector="Window.video-summary-result Border.summary-inset, Window.video-summary-result Border.summary-chip">
    <Setter Property="Background" Value="{DynamicResource UiSurfaceRaised}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource UiControlRadius}"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>
  <Style Selector="Window.video-summary-result Border.summary-chip"><Setter Property="Margin" Value="0,0,4,4"/><Setter Property="Padding" Value="6,1"/></Style>
  <Style Selector="Window.video-summary-result SelectableTextBlock.summary-prose">
    <Setter Property="FontSize" Value="{DynamicResource UiSummaryFontSize}"/>
    <Setter Property="LineHeight" Value="{DynamicResource UiSummaryLineHeight}"/>
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
  </Style>
  <Style Selector="Window.video-summary-result SelectableTextBlock.summary-heading">
    <Setter Property="FontSize" Value="{DynamicResource UiFontBody}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Window.video-summary-result TextBlock.summary-section">
    <Setter Property="FontSize" Value="{DynamicResource UiFontBody}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Window.video-summary-result SelectableTextBlock.summary-code"><Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/></Style>
  <Style Selector="Window.video-summary-result Border.summary-rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource UiDivider}"/></Style>
  <Style Selector="Window.video-summary-result Border.summary-quote">
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="Padding" Value="8,2"/>
  </Style>
  <Style Selector="Window.video-summary-result Border.summary-table-cell">
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="4,2"/>
  </Style>
  <Style Selector="Window.video-summary-result Border.summary-table-header"><Setter Property="Background" Value="{DynamicResource UiSurfaceRaised}"/></Style>
  <Style Selector="Window.video-summary-result Button.summary-time">
    <Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    <Setter Property="MinHeight" Value="22"/><Setter Property="Padding" Value="4,0"/>
  </Style>
  <Style Selector="Window.video-summary-result ListBox.summary-nav">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Window.video-summary-result ListBox.summary-nav ListBoxItem">
    <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style Selector="Window.video-summary-result ListBox.summary-transcript ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="2,1"/><Setter Property="MinHeight" Value="0"/>
  </Style>
</Styles>
