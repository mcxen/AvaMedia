      <x:Double x:Key="UiToolTitleBarHeight">48</x:Double>
      <x:Double x:Key="UiToolTitleGutter">88</x:Double>
      <Thickness x:Key="UiToolTitleLightInset">16,0,0,0</Thickness>
      <x:Double x:Key="UiMainTitleLightInset">20</x:Double>
      <x:Double x:Key="UiToolWindowGap">12</x:Double>
