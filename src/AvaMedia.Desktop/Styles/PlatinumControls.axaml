<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AvaMedia.Desktop.Controls">
  <!-- Platinum bevel tones adapted from npjg/classic.css (MIT, Nathanael Gentry).
       Control behavior and named parts inherit Avalonia SimpleTheme (MIT). -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://AvaMedia.Desktop/Styles/PlatinumMenus.axaml"/>
    <ResourceInclude Source="avares://AvaMedia.Desktop/Styles/PlatinumFields.axaml"/>
  </ResourceDictionary.MergedDictionaries>
  <ControlTheme x:Key="PlatinumButtonTheme" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Template">
      <ControlTemplate>
        <controls:PlatinumBevel Name="PlatinumFace" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3" IsDefaultFace="{TemplateBinding IsDefault}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </controls:PlatinumBevel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed /template/ controls|PlatinumBevel#PlatinumFace"><Setter Property="IsPressed" Value="True"/></Style>
    <Style Selector="^:focus-visible /template/ controls|PlatinumBevel#PlatinumFace"><Setter Property="IsFocusedFace" Value="True"/></Style>
    <Style Selector="^[IsDefault=true]"><Setter Property="BorderThickness" Value="4"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumBevelButtonTheme" TargetType="Button" BasedOn="{StaticResource PlatinumButtonTheme}">
    <Style Selector="^ /template/ controls|PlatinumBevel#PlatinumFace"><Setter Property="CornerRadius" Value="0"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumCaptionButtonTheme" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumTextBoxTheme" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Style Selector="^ /template/ Border#border, ^:pointerover /template/ Border#border, ^:focus /template/ Border#border"><Setter Property="BoxShadow" Value="{DynamicResource UiInsetShadow}"/><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderBrush" Value="Black"/><Setter Property="BorderThickness" Value="1"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumTabItemTheme" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="FontSize" Value="{DynamicResource UiFontBody}"/>
    <Setter Property="Padding" Value="9,5,9,3"/>
    <Setter Property="Template"><ControlTemplate><controls:PlatinumTabFace Name="PlatinumTab" Padding="{TemplateBinding Padding}" IsSelected="{TemplateBinding IsSelected}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True" VerticalContentAlignment="Center"/></controls:PlatinumTabFace></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:selected /template/ ContentPresenter#PART_ContentPresenter, ^:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumScrollBarTheme" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
    <Style Selector="^ /template/ Border"><Setter Property="Background" Value="#BBBBBB"/><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="{DynamicResource UiInsetShadow}"/></Style>
    <Style Selector="^ /template/ RepeatButton.repeat"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><ControlTemplate><controls:PlatinumBevel Name="ArrowFace" Background="{DynamicResource UiSurfaceRaised}" BorderThickness="2" IsPressed="{TemplateBinding IsPressed}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></controls:PlatinumBevel></ControlTemplate></Setter></Style>
    <Style Selector="^ /template/ RepeatButton > Path, ^ /template/ RepeatButton:pointerover > Path"><Setter Property="Fill" Value="Black"/></Style>
    <Style Selector="^ /template/ Thumb#thumb, ^ /template/ Thumb#thumb:pointerover, ^ /template/ Thumb#thumb:pressed"><Setter Property="Background" Value="{DynamicResource UiAccentFace}"/></Style>
    <Style Selector="^:horizontal /template/ Thumb#thumb"><Setter Property="MinWidth" Value="20"/><Setter Property="Height" Value="16"/><Setter Property="Template"><ControlTemplate><controls:PlatinumBevel Background="{TemplateBinding Background}" BorderThickness="2" Grip="vertical"/></ControlTemplate></Setter></Style>
    <Style Selector="^:vertical /template/ Thumb#thumb"><Setter Property="MinHeight" Value="20"/><Setter Property="Width" Value="16"/><Setter Property="Template"><ControlTemplate><controls:PlatinumBevel Background="{TemplateBinding Background}" BorderThickness="2" Grip="horizontal"/></ControlTemplate></Setter></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumSliderTheme" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Style Selector="^ /template/ Border#TrackBackground"><Setter Property="Background" Value="#999999"/><Setter Property="BorderBrush" Value="Black"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="inset 1 1 0 0 #777777, inset -1 -1 0 0 #FFFFFF"/></Style>
    <Style Selector="^:horizontal /template/ Thumb#thumb"><Setter Property="MinWidth" Value="14"/><Setter Property="MinHeight" Value="16"/><Setter Property="Template"><ControlTemplate><controls:PlatinumBevel Width="14" Height="16" Background="{DynamicResource UiAccentFace}" BorderThickness="2" Grip="vertical"/></ControlTemplate></Setter></Style>
    <Style Selector="^:vertical /template/ Thumb#thumb"><Setter Property="MinWidth" Value="16"/><Setter Property="MinHeight" Value="14"/><Setter Property="Template"><ControlTemplate><controls:PlatinumBevel Width="16" Height="14" Background="{DynamicResource UiAccentFace}" BorderThickness="2" Grip="horizontal"/></ControlTemplate></Setter></Style>
  </ControlTheme>
  <ControlTheme x:Key="PlatinumProgressBarTheme" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Background" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="Black"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#DDDDEE" Offset="0"/><GradientStop Color="#AAAACC" Offset="0.35"/><GradientStop Color="#777799" Offset="1"/></LinearGradientBrush></Setter>
    <Style Selector="^:horizontal"><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="10"/></Style>
    <Style Selector="^ /template/ Border"><Setter Property="CornerRadius" Value="0"/></Style>
    <Style Selector="^ /template/ Border#PART_Indicator, ^ /template/ Border#PART_IndeterminateIndicator"><Setter Property="BorderBrush" Value="#555577"/><Setter Property="BorderThickness" Value="0,0,1,0"/></Style>
  </ControlTheme>
</ResourceDictionary>
