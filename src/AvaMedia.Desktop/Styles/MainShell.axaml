<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AvaMedia.Desktop.Controls">
  <!-- Main window shell for the light / dark skins, after the R2 macOS-style design (see docs/SIDEBAR-TREE.md). -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellSidebar" Color="#F1F4FA"/>
          <SolidColorBrush x:Key="ShellCapsule" Color="#F2FFFFFF"/>
          <SolidColorBrush x:Key="ShellCapsuleHover" Color="#0F000000"/>
          <SolidColorBrush x:Key="ShellHairline" Color="#1F000000"/>
          <SolidColorBrush x:Key="ShellListHeader" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="ShellAltRow" Color="#FAFAFC"/>
          <SolidColorBrush x:Key="ShellSeparator" Color="#F0F0F2"/>
          <SolidColorBrush x:Key="ShellHeaderLine" Color="#E5E5EA"/>
          <SolidColorBrush x:Key="ShellSelected" Color="#14007AFF"/>
          <SolidColorBrush x:Key="ShellRowHover" Color="#08000000"/>
          <SolidColorBrush x:Key="ShellDoneBar" Color="#F5F5F7"/>
          <SolidColorBrush x:Key="ShellLabel" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="ShellSecondary" Color="#86868B"/>
          <SolidColorBrush x:Key="ShellCapText" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ShellBlue" Color="#007AFF"/>
          <SolidColorBrush x:Key="ShellDash" Color="#C7C7CC"/>
          <SolidColorBrush x:Key="ShellTrack" Color="#E5E5EA"/>
          <SolidColorBrush x:Key="ShellRed" Color="#FF3B30"/>
          <SolidColorBrush x:Key="ShellGreen" Color="#34C759"/>
          <SolidColorBrush x:Key="ShellWait" Color="#8E8E93"/>
          <SolidColorBrush x:Key="ShellFlap" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ShellWindow" Color="#FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellSidebar" Color="#2A2C31"/>
          <SolidColorBrush x:Key="ShellCapsule" Color="#E63A3A3C"/>
          <SolidColorBrush x:Key="ShellCapsuleHover" Color="#1FFFFFFF"/>
          <SolidColorBrush x:Key="ShellHairline" Color="#33FFFFFF"/>
          <SolidColorBrush x:Key="ShellListHeader" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="ShellAltRow" Color="#232325"/>
          <SolidColorBrush x:Key="ShellSeparator" Color="#333336"/>
          <SolidColorBrush x:Key="ShellHeaderLine" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ShellSelected" Color="#330A84FF"/>
          <SolidColorBrush x:Key="ShellRowHover" Color="#0FFFFFFF"/>
          <SolidColorBrush x:Key="ShellDoneBar" Color="#2C2C2E"/>
          <SolidColorBrush x:Key="ShellLabel" Color="#F5F5F7"/>
          <SolidColorBrush x:Key="ShellSecondary" Color="#98989D"/>
          <SolidColorBrush x:Key="ShellCapText" Color="#E5E5EA"/>
          <SolidColorBrush x:Key="ShellBlue" Color="#0A84FF"/>
          <SolidColorBrush x:Key="ShellDash" Color="#545458"/>
          <SolidColorBrush x:Key="ShellTrack" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ShellRed" Color="#FF453A"/>
          <SolidColorBrush x:Key="ShellGreen" Color="#30D158"/>
          <SolidColorBrush x:Key="ShellWait" Color="#98989D"/>
          <SolidColorBrush x:Key="ShellFlap" Color="#3A3A3C"/>
          <SolidColorBrush x:Key="ShellWindow" Color="#1E1E1E"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- Shared defaults (all skins). -->
  <Style Selector="Border.queue-heading TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
  <Style Selector=":is(Control).modern-only"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) :is(Control).modern-only"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) :is(Control).classic-only"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp)"><Setter Property="Background" Value="{DynamicResource ShellWindow}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Grid.workspace-layout"><Setter Property="Margin" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.feature-sidebar"><Setter Property="Margin" Value="8"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="{DynamicResource ShellSidebar}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BoxShadow" Value="0 0 0 0.5 #1A000000, 0 4 16 -6 #26000000"/><Setter Property="Padding" Value="2,6,2,4"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.task-workspace"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Margin" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) GridSplitter.workspace-splitter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Grid.modern-title"><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="10,4,14,0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) TextBlock.modern-title-text"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) TextBlock.modern-subtitle"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Grid.modern-queuebar"><Setter Property="Margin" Value="10,10,14,6"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) TextBlock.modern-section"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.capsule"><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="{DynamicResource ShellCapsule}"/><Setter Property="BoxShadow" Value="0 0 0 0.5 #1F000000, 0 2 8 -2 #26000000"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="9,0"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource ShellCapText}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellCapsuleHover}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap controls|ActionIcon, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap controls|ActionIcon.danger, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap controls|ActionIcon.success"><Setter Property="Foreground" Value="{DynamicResource ShellCapText}"/><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap controls|LucideIcon"><Setter Property="Foreground" Value="{DynamicResource ShellCapText}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap Path"><Setter Property="Stroke" Value="{DynamicResource ShellCapText}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary"><Setter Property="Background" Value="{DynamicResource ShellBlue}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellBlue}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary controls|ActionIcon, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary controls|ActionIcon.success"><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.queue-card"><Setter Property="Margin" Value="14,0,14,0"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="BoxShadow" Value="0 0 0 0.5 #1F000000"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.completed-tasks-bar"><Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Background" Value="{DynamicResource ShellDoneBar}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellHeaderLine}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.completed-tasks-bar Button"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource ShellCapText}"/><Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="28"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.completed-tasks-bar Path"><Setter Property="Stroke" Value="{DynamicResource ShellCapText}"/><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.queue-heading"><Setter Property="Height" Value="26"/><Setter Property="Background" Value="{DynamicResource ShellListHeader}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellHeaderLine}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.queue-heading Border"><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.queue-heading TextBlock"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/><Setter Property="Margin" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem"><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ShellSeparator}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="{DynamicResource ShellAltRow}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource ShellRowHover}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellSeparator}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellRowHover}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellSelected}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ShellSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellSeparator}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Grid.queue-row"><Setter Property="Margin" Value="0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list StackPanel.queue-details"><Setter Property="Spacing" Value="3"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Button#CoverButton"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Border.queue-artwork"><Setter Property="CornerRadius" Value="5"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Image.queue-cover"><Setter Property="Stretch" Value="UniformToFill"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-name"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-secondary"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-target"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Grid.queue-progress"><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Width" Value="140"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Grid.queue-state-slot"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Height" Value="18"/><Setter Property="MaxHeight" Value="18"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list ProgressBar"><Setter Property="Height" Value="4"/><Setter Property="MinHeight" Value="4"/><Setter Property="MaxHeight" Value="4"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Background" Value="{DynamicResource ShellTrack}"/><Setter Property="Foreground" Value="{DynamicResource ShellBlue}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-state"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource ShellWait}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-state.running"><Setter Property="Foreground" Value="{DynamicResource ShellBlue}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-state.completed"><Setter Property="Foreground" Value="{DynamicResource ShellGreen}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list TextBlock.queue-state.failed"><Setter Property="Foreground" Value="{DynamicResource ShellRed}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list controls|LucideIcon.queue-state-icon"><Setter Property="Foreground" Value="{DynamicResource ShellWait}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list controls|LucideIcon.queue-state-icon.completed"><Setter Property="Foreground" Value="{DynamicResource ShellGreen}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list controls|LucideIcon.queue-state-icon.failed"><Setter Property="Foreground" Value="{DynamicResource ShellRed}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) ListBox.task-list Button#ViewResultButton"><Setter Property="MinHeight" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="6,0"/><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host"><Setter Property="Margin" Value="14,10,14,12"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host Border.app-statusbar"><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="BoxShadow" Value="0 0 0 0.5 #1A000000"/><Setter Property="Padding" Value="12,0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host CheckBox"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.queue-heading Grid > TextBlock:nth-child(1)"><Setter Property="Margin" Value="12,0,0,0"/></Style>
  <Style Selector="ListBox.task-list Button#CoverButton:disabled"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="ListBox.task-list Button#CoverButton:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:disabled"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellTrack}"/><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:disabled controls|ActionIcon, Window.main-window:not(.mac-os9):not(.windows-xp) Button.cap.primary:disabled controls|ActionIcon.success"><Setter Property="Foreground" Value="{DynamicResource ShellSecondary}"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host TextBlock.status-summary"><Setter Property="TextTrimming" Value="None"/><Setter Property="Margin" Value="14,0"/></Style>
  <Style Selector="Window.main-window:not(.mac-os9):not(.windows-xp) Border.modern-status-host controls|SplitFlapPercentage"><Setter Property="Background" Value="{DynamicResource ShellFlap}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellSeparator}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/><Setter Property="Margin" Value="5,0,12,0"/></Style>
  <Style Selector="Window.main-window Button.caption"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="Window.main-window Button.caption controls|LucideIcon"><Setter Property="Foreground" Value="{DynamicResource ShellLabel}"/><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/></Style>
  <Style Selector="Window.main-window Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ShellRowHover}"/></Style>
  <Style Selector="Window.main-window Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#C42B1C"/></Style>
  <Style Selector="Window.main-window Button.caption.close:pointerover controls|LucideIcon"><Setter Property="Foreground" Value="White"/></Style>
  <!-- Tool tree sizing and per-skin parts (Mac OS 9 gets Platinum artwork, bars and triangles). -->
  <Style Selector="Button.feature-tree-row"><Setter Property="Height" Value="26"/></Style>
  <Style Selector="Button.feature-tree-category"><Setter Property="Height" Value="28"/></Style>
  <Style Selector="TextBlock.feature-tree-group"><Setter Property="Height" Value="20"/></Style>
  <Style Selector=":is(Control).platinum-only"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.mac-os9 :is(Control).platinum-only"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="Window.mac-os9 :is(Control).non-platinum"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Border.beta-badge"><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="#24FF9500"/></Style>
  <Style Selector="Border.beta-badge TextBlock"><Setter Property="Foreground" Value="#E08200"/></Style>
  <Style Selector="Window.mac-os9 Border.beta-badge"><Setter Property="CornerRadius" Value="0"/><Setter Property="Background" Value="#DDDDDD"/><Setter Property="BorderBrush" Value="#666666"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Window.mac-os9 Border.beta-badge TextBlock"><Setter Property="Foreground" Value="#000000"/><Setter Property="FontWeight" Value="Normal"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-row"><Setter Property="Height" Value="21"/></Style>
  <Style Selector="Window.mac-os9 TextBlock.feature-tree-group"><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="20,3,0,0"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-category"><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,1"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-category /template/ Border#PART_NavigationFace"><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#808080"/><Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#F2F2F2" Offset="0"/><GradientStop Color="#D4D4D4" Offset="1"/></LinearGradientBrush></Setter></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-category:pressed /template/ Border#PART_NavigationFace"><Setter Property="Background" Value="#A8A8A8"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-category Path.tree-chevron"><Setter Property="Fill" Value="#000000"/><Setter Property="Stroke" Value="#000000"/><Setter Property="StrokeThickness" Value="0.5"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-category controls|LucideIcon"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Window.mac-os9 Button.feature-tree-row /template/ Border#PART_NavigationFace"><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="Window.mac-os9 ListBox.task-list Grid.queue-state-slot"><Setter Property="Height" Value="22"/></Style>
  <Style Selector="Window.mac-os9 ListBox.task-list StackPanel.queue-details"><Setter Property="Spacing" Value="1"/></Style>
</Styles>
