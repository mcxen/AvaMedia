<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AvaMedia.Desktop.Controls">
  <!-- Shared structure; the classic appearance is scoped to the two standard themes. -->
  <Style Selector="Border.app-toolbar"><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.feature-sidebar"><Setter Property="BorderThickness" Value="0,0,1,0"/></Style>
  <Style Selector="Border.queue-heading"><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.completed-tasks-bar"><Setter Property="BorderThickness" Value="1,1,1,0"/></Style>
  <Style Selector="ListBox.task-list"><Setter Property="BorderThickness" Value="1,0,1,1"/></Style>
  <Style Selector="GridSplitter.workspace-splitter"><Setter Property="Background" Value="{DynamicResource UiDivider}"/></Style>
  <Style Selector="Grid.queue-row"><Setter Property="Margin" Value="0,8"/></Style>
  <Style Selector="StackPanel.queue-details"><Setter Property="Spacing" Value="4"/></Style>

  <!-- BluePrint's inset 12px content shell, with Motrix's quiet neutral surfaces. -->
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Grid.workspace-layout">
    <Setter Property="Margin" Value="8,4,8,0"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.feature-sidebar">
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.task-workspace">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) GridSplitter.workspace-splitter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.app-toolbar">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.queue-heading, Window:not(.mac-os9):not(.windows-xp) Border.completed-tasks-bar">
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.queue-heading TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem">
    <Setter Property="Margin" Value="6,2"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource UiTaskSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiTileBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource UiSelection}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
  </Style>

  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.tool">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.primary:not(.ac)">
    <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
    <Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.tool controls|ActionIcon:not(.danger):not(.success)">
    <Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.tool controls|ActionIcon">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.primary controls|ActionIcon">
    <Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.category">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="8,3"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.category.expanded">
    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    <Setter Property="Background" Value="{DynamicResource UiPressed}"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.category TextBlock.title">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.feature-tile">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="5,3"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.feature-format">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource UiTileBorder}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list Grid.queue-row">
    <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list StackPanel.queue-details">
    <Setter Property="Spacing" Value="2"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list Grid.queue-state-slot">
    <Setter Property="MaxHeight" Value="24"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list Button#ViewResultButton">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="6,1"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    <Setter Property="Background" Value="{DynamicResource UiDivider}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.task-list ProgressBar">
    <Setter Property="MaxHeight" Value="4"/>
  </Style>
  <Style Selector="Window:not(.mac-os9):not(.windows-xp) Border.app-statusbar">
    <Setter Property="Padding" Value="7,0"/>
  </Style>
  <Style Selector="Window.settings:not(.mac-os9):not(.windows-xp) Border.settingSection">
    <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
</Styles>
