<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AvaMedia.Desktop.Controls">

  <Style Selector="Window.player Button.player-transport controls|ActionIcon">
    <Setter Property="Width" Value="{DynamicResource UiIconSize}"/><Setter Property="Height" Value="{DynamicResource UiIconSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
  </Style>

  <Style Selector="Window.player TextBlock.time"><Setter Property="MinHeight" Value="0"/></Style>
</Styles>
