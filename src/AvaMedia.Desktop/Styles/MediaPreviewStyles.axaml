<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AvaMedia.Desktop">
  <Styles.Resources>
    <ResourceDictionary>
      <x:Double x:Key="UiMediaPreviewAmbientBlur">72</x:Double>
      <x:Double x:Key="UiMediaPreviewAmbientSpread">12</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <BoxShadows x:Key="UiMediaPreviewShadow">0 1 2 0 #0F000000, 0 8 24 0 #1A000000, 0 24 48 0 #14000000</BoxShadows>
          <CornerRadius x:Key="UiMediaPreviewRadius">10</CornerRadius>
          <x:Double x:Key="UiMediaPreviewAmbientOpacity">0.30</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <BoxShadows x:Key="UiMediaPreviewShadow">0 1 2 0 #0F000000, 0 8 24 0 #1A000000, 0 24 48 0 #14000000</BoxShadows>
          <CornerRadius x:Key="UiMediaPreviewRadius">10</CornerRadius>
          <x:Double x:Key="UiMediaPreviewAmbientOpacity">0.18</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:Skin.MacOS9}">
          <BoxShadows x:Key="UiMediaPreviewShadow">none</BoxShadows>
          <CornerRadius x:Key="UiMediaPreviewRadius">0</CornerRadius>
          <x:Double x:Key="UiMediaPreviewAmbientOpacity">0</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:Skin.WindowsXP}">
          <BoxShadows x:Key="UiMediaPreviewShadow">none</BoxShadows>
          <CornerRadius x:Key="UiMediaPreviewRadius">3</CornerRadius>
          <x:Double x:Key="UiMediaPreviewAmbientOpacity">0</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
