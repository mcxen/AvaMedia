<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon/v2/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Updates/Install.ps1" LogicalName="AvaMedia.Desktop.Updates.Install.ps1" />
    <EmbeddedResource Include="Updates/Install.sh" LogicalName="AvaMedia.Desktop.Updates.Install.sh" />
    <EmbeddedResource Include="Localization/Strings.en-US.json" LogicalName="AvaMedia.Desktop.Strings.en-US.json" WithCulture="false" />
    <EmbeddedResource Include="WifiTransfer/index.html" LogicalName="AvaMedia.Desktop.WifiTransfer.html" />
    <AvaloniaResource Include="Assets/FeatureIcons/v2/*.png" />
    <AvaloniaResource Include="Assets/FeatureIcons/macos9/*.png" Exclude="Assets/FeatureIcons/macos9/pdf-*.png;Assets/FeatureIcons/macos9/text-pdf.png;Assets/FeatureIcons/macos9/zip.png;Assets/FeatureIcons/macos9/unzip.png" />
    <AvaloniaResource Include="Assets/FeatureIcons/macos9/pdf-*.png;Assets/FeatureIcons/macos9/text-pdf.png;Assets/FeatureIcons/macos9/zip.png;Assets/FeatureIcons/macos9/unzip.png" />
    <AvaloniaResource Include="Assets/AppIcon/v2/app.ico" />
    <AvaloniaResource Include="Assets/AppIcon/v2/app.png" />
    <AvaloniaResource Include="Assets/Fonts/Platinum/*.ttf" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../AvaMedia.Core/AvaMedia.Core.csproj" />
    <EmbeddedResource Include="Browser/MediaSniffer.js" LogicalName="AvaMedia.Desktop.MediaSniffer.js" />
  </ItemGroup>
</Project>
