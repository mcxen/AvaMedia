<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../AvaMedia.Desktop/Assets/Fonts/Platinum/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <!-- Noto Sans CJK SC (OFL 1.1), subset to GB2312 + Big5 level 1 + Latin; the pixel font remains the fallback. -->
    <AvaloniaResource Include="Fonts/*.otf" />
    <EmbeddedResource Include="../AvaMedia.Desktop/Localization/Strings.en-US.json" LogicalName="AvaMedia.Browser.Strings.Desktop.json" Link="Strings/Desktop.json" />
    <EmbeddedResource Include="Strings/Remote.json" LogicalName="AvaMedia.Browser.Strings.Remote.json" />
    <Compile Include="../AvaMedia.Desktop/Controls/LucideIcons.cs" Link="Shared/LucideIcons.cs" />
    <Compile Include="../AvaMedia.Desktop/Controls/LucideIcon.cs" Link="Shared/LucideIcon.cs" />
    <EmbeddedResource Include="../AvaMedia.Desktop/Assets/ToolbarIcons/Lucide/*.svg" LogicalName="AvaMedia.Desktop.Lucide.%(Filename).svg" Link="Lucide/%(Filename).svg" />
    <PackageReference Include="Avalonia.Browser" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <ProjectReference Include="../AvaMedia.MediaUi/AvaMedia.MediaUi.csproj" />
    <ProjectReference Include="../AvaMedia.FileUi/AvaMedia.FileUi.csproj" />
  </ItemGroup>
  <!-- Consume the DTO declarations from the shared source without linking desktop-only
       inference, process and disk services into WebAssembly. No second contract is maintained. -->
  <Target Name="GenerateAiProgressDtos" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_AiContract>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../AvaMedia.Core/AiProgressContract.cs'))</_AiContract>
      <_AiDtos>$([System.Text.RegularExpressions.Regex]::Match('$(_AiContract)', '(?s)public sealed record.*?(?=public static class)').Value)</_AiDtos>
    </PropertyGroup>
    <Error Condition="'$(_AiDtos)' == ''" Text="Shared AI progress DTO declarations were not found." />
    <WriteLinesToFile File="$(IntermediateOutputPath)AiProgressDtos.g.cs" Lines="#nullable enable&#xA;namespace AvaMedia.Core%3B&#xA;$(_AiDtos)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)AiProgressDtos.g.cs" /></ItemGroup>
  </Target>
</Project>
