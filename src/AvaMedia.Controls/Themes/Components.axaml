<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="using:AvaMedia.Controls">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://AvaMedia.Controls/Themes/Defaults.axaml"/>
    <ResourceInclude Source="avares://AvaMedia.Controls/Themes/ControlThemes.axaml"/>
    <ResourceInclude Source="avares://AvaMedia.Controls/Themes/TaskSubmissionShell.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources>
<Style Selector="ac|EmptyState.error"><Setter Property="IsError" Value="True"/></Style>
<Style Selector="Border.ac-card"><Setter Property="Background" Value="{DynamicResource AcCardFace}"/><Setter Property="CornerRadius" Value="{DynamicResource AcCardRadius}"/><Setter Property="Padding" Value="{DynamicResource AcCardPadding}"/><Setter Property="BoxShadow" Value="{DynamicResource AcCardShadow}"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Border.ac-list-row"><Setter Property="Height" Value="{DynamicResource AcListHeight}"/><Setter Property="Margin" Value="{DynamicResource AcListMargin}"/><Setter Property="Padding" Value="{DynamicResource AcListPadding}"/><Setter Property="CornerRadius" Value="{DynamicResource AcListRadius}"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Border.ac-list-row.text"><Setter Property="Height" Value="{DynamicResource AcTextRowHeight}"/></Style>
<Style Selector="Border.ac-list-row:pointerover"><Setter Property="Background" Value="{DynamicResource UiFill}"/></Style>
<Style Selector="Border.ac-list-row.ac-hover"><Setter Property="Background" Value="{DynamicResource UiFill}"/></Style>
<Style Selector="Border.ac-list-row.selected"><Setter Property="Background" Value="{DynamicResource AcSelection}"/></Style>
<Style Selector="Border.ac-list-row.active"><Setter Property="Background" Value="{DynamicResource UiAccent}"/></Style>
<Style Selector="Border.ac-list-row.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/></Style>
<Style Selector="Border.ac-list-row:disabled"><Setter Property="Opacity" Value="{DynamicResource AcDisabledOpacity}"/></Style>
<Style Selector="Border.ac-status"><Setter Property="Height" Value="{DynamicResource AcStatusHeight}"/><Setter Property="CornerRadius" Value="{DynamicResource AcStatusRadius}"/><Setter Property="Padding" Value="{DynamicResource AcStatusPadding}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style Selector="Border.ac-badge"><Setter Property="MinWidth" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="5,0"/><Setter Property="Background" Value="{DynamicResource UiDanger}"/></Style>
<Style Selector="Border.ac-badge TextBlock"><Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/></Style>
<Style Selector="Border.ac-badge.blue"><Setter Property="Background" Value="{DynamicResource UiAccent}"/></Style>
<Style Selector="Border.ac-badge.neutral"><Setter Property="Background" Value="{DynamicResource AcFillPressed}"/></Style>
<Style Selector="Border.ac-badge.neutral TextBlock"><Setter Property="Foreground" Value="{DynamicResource UiText}"/></Style>
<Style Selector="Border.ac-badge.dot"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/></Style>
<Style Selector="Border.ac-badge.dot TextBlock"><Setter Property="IsVisible" Value="False"/></Style>
<Style Selector="TextBlock.ac-section"><Setter Property="FontSize" Value="{DynamicResource AcSectionFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Margin" Value="{DynamicResource AcSectionMargin}"/></Style>
<Style Selector="TextBlock.ac-caption"><Setter Property="FontSize" Value="{DynamicResource AcCaptionFont}"/><Setter Property="Foreground" Value="{DynamicResource UiTextSecondary}"/></Style>
<Style Selector="TextBlock.ac-error"><Setter Property="FontSize" Value="{DynamicResource AcSubStepFont}"/><Setter Property="Foreground" Value="{DynamicResource UiDanger}"/><Setter Property="Margin" Value="{DynamicResource AcFieldErrorMargin}"/></Style>
<Style Selector="Border.ac-group"><Setter Property="Background" Value="{DynamicResource AcCardFace}"/><Setter Property="CornerRadius" Value="{DynamicResource AcGroupRadius}"/><Setter Property="BorderBrush" Value="{DynamicResource AcStageLineBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource AcHairlineThickness}"/><Setter Property="ClipToBounds" Value="True"/></Style>
<Style Selector="Border.ac-setting-row"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,0"/></Style>
<Style Selector="Border.ac-setting-row.divider"><Setter Property="BorderBrush" Value="{DynamicResource AcStageLineBrush}"/><Setter Property="BorderThickness" Value="0,0.5,0,0"/></Style>
<Style Selector="Border.ac-popover"><Setter Property="Background" Value="{DynamicResource AcMenuFill}"/><Setter Property="CornerRadius" Value="{DynamicResource AcCardRadius}"/><Setter Property="Padding" Value="{DynamicResource AcPopoverPadding}"/><Setter Property="BoxShadow" Value="{DynamicResource AcPopupShadow}"/></Style>
<Style Selector="Border.ac-sheet"><Setter Property="Background" Value="{DynamicResource AcSheetFace}"/><Setter Property="CornerRadius" Value="{DynamicResource AcSheetRadius}"/><Setter Property="Padding" Value="{DynamicResource AcSheetPadding}"/><Setter Property="BoxShadow" Value="{DynamicResource AcPopupShadow}"/></Style>
<!-- A sheet inside a native top-level window has one padding layer and no popup decoration. -->
<Style Selector="Border.ac-sheet.window"><Setter Property="CornerRadius" Value="0"/><Setter Property="BoxShadow" Value="none"/></Style>
<Style Selector="Border.ac-notice"><Setter Property="Background" Value="{DynamicResource AcNoticeFace}"/><Setter Property="CornerRadius" Value="{DynamicResource AcGroupRadius}"/><Setter Property="Padding" Value="{DynamicResource AcNoticePadding}"/><Setter Property="BoxShadow" Value="{DynamicResource AcCardShadow}"/><Setter Property="ClipToBounds" Value="True"/></Style>
<Style Selector="Border.ac-notice.warning"><Setter Property="Background" Value="{DynamicResource AcBanner}"/></Style>
<Style Selector="Border.ac-tooltip"><Setter Property="Background" Value="{DynamicResource AcMenuFill}"/><Setter Property="CornerRadius" Value="{DynamicResource AcFieldRadius}"/><Setter Property="Padding" Value="{DynamicResource AcTooltipPadding}"/><Setter Property="BoxShadow" Value="{DynamicResource AcPopupShadow}"/></Style>
<Style Selector="Border.ac-tooltip TextBlock"><Setter Property="FontSize" Value="{DynamicResource AcCaptionFont}"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/></Style>
<Style Selector="Border.ac-split"><Setter Property="CornerRadius" Value="{DynamicResource AcButtonRadius}"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="Background" Value="{DynamicResource UiFill}"/><Setter Property="BorderBrush" Value="{DynamicResource AcButtonBorder}"/><Setter Property="BorderThickness" Value="{DynamicResource AcOutlineThickness}"/><Setter Property="BoxShadow" Value="{DynamicResource AcButtonShadow}"/></Style>
<Style Selector="Border.ac-split.primary"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiPrimaryPressed}"/></Style>
<Style Selector="Border.ac-split Button.ac"><Setter Property="CornerRadius" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Border.ac-split Button.ac.split-arrow"><Setter Property="Padding" Value="{DynamicResource AcTextButtonPadding}"/><Setter Property="BorderThickness" Value="0.5,0,0,0"/><Setter Property="BorderBrush" Value="{DynamicResource AcHairline}"/></Style>
<Style Selector="Border.ac-split.primary Button.ac.split-arrow"><Setter Property="BorderBrush" Value="{DynamicResource AcHairline}"/></Style>
<Style Selector="ListBox.ac-segmented"><Setter Property="Background" Value="{DynamicResource UiFill}"/><Setter Property="CornerRadius" Value="{DynamicResource AcSegmentRadius}"/><Setter Property="Padding" Value="{DynamicResource AcSegmentPadding}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="28"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="ItemContainerTheme" Value="{DynamicResource AcSegmentItem}"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></Border></ControlTemplate></Setter></Style>
<Style Selector="ListBox.ac-segmented:disabled"><Setter Property="Opacity" Value="{DynamicResource AcDisabledOpacity}"/></Style>
<Style Selector="ListBox.ac-segmented.tabs"><Setter Property="Height" Value="NaN"/><Setter Property="Background" Value="{DynamicResource UiTransparent}"/><Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="{DynamicResource AcStageLineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/><Setter Property="CornerRadius" Value="0"/><Setter Property="ItemContainerTheme" Value="{DynamicResource AcTabSegmentItem}"/></Style>
<Style Selector="ac|LoadingSpinner"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/></Style>
<Style Selector="ac|LoadingSpinner.large"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/></Style>
<Style Selector="ac|ProgressRing"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/></Style>
<Style Selector="Thumb.ac-range-thumb"><Setter Property="Width" Value="{DynamicResource AcSliderThumb}"/><Setter Property="Height" Value="{DynamicResource AcSliderThumb}"/><Setter Property="Template"><ControlTemplate><Border Name="rangeKnob" Background="{DynamicResource AcKnob}" CornerRadius="{DynamicResource AcStatusRadius}" BoxShadow="{DynamicResource AcKnobShadow}"/></ControlTemplate></Setter></Style>
<Style Selector="Thumb.ac-range-thumb:focus-visible /template/ Border#rangeKnob"><Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="Thumb.ac-range-thumb.ac-focus /template/ Border#rangeKnob"><Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="ac|RangeSlider:disabled"><Setter Property="Opacity" Value="{DynamicResource AcDisabledOpacity}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) Button.ac"><Setter Property="Theme" Value="{DynamicResource AcButton}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) CheckBox.ac"><Setter Property="Theme" Value="{DynamicResource AcCheckBox}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) RadioButton.ac"><Setter Property="Theme" Value="{DynamicResource AcRadioButton}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ToggleSwitch.ac"><Setter Property="Theme" Value="{DynamicResource AcToggleSwitch}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ComboBox.ac"><Setter Property="Theme" Value="{DynamicResource AcComboBox}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) NumericUpDown.ac"><Setter Property="Theme" Value="{DynamicResource AcNumericUpDown}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TextBox.ac"><Setter Property="Theme" Value="{DynamicResource AcTextBox}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) Slider.ac"><Setter Property="Theme" Value="{DynamicResource AcSlider}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ProgressBar.ac"><Setter Property="Theme" Value="{DynamicResource AcProgressBar}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ToolTip.ac"><Setter Property="Theme" Value="{DynamicResource AcToolTip}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ScrollBar.ac"><Setter Property="Theme" Value="{DynamicResource AcScrollBar}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ContextMenu.ac"><Setter Property="Theme" Value="{DynamicResource AcContextMenu}"/></Style>
<Style Selector="ButtonSpinner /template/ RepeatButton:pressed /template/ Border#stepFace">
    <Setter Property="Background" Value="{DynamicResource AcFillPressed}"/></Style>
<Style Selector="NumericUpDown:focus-within /template/ TextBox#PART_TextBox /template/ Border#border">
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="NumericUpDown.ac-focus /template/ TextBox#PART_TextBox /template/ Border#border">
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="NumericUpDown.error /template/ TextBox#PART_TextBox /template/ Border#border">
    <Setter Property="BorderBrush" Value="{DynamicResource UiDanger}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AcErrorShadow}"/></Style>
<Style Selector="ComboBox[IsEditable=true] /template/ ToggleButton#toggle /template/ Border#chevron"><Setter Property="Background" Value="{DynamicResource UiTransparent}"/></Style>
<Style Selector="ComboBox[IsEditable=true] /template/ ToggleButton#toggle /template/ Path#arrows"><Setter Property="Data" Value="M1,1 L4,4 L7,1"/><Setter Property="Height" Value="5"/><Setter Property="Stroke" Value="{DynamicResource UiTextSecondary}"/></Style>
<Style Selector="ComboBox.pulldown /template/ ToggleButton#toggle /template/ Border#chevron"><Setter Property="Background" Value="{DynamicResource UiTransparent}"/></Style>
<Style Selector="ComboBox.pulldown /template/ ToggleButton#toggle /template/ Path#arrows"><Setter Property="Data" Value="M1,1 L4,4 L7,1"/><Setter Property="Height" Value="5"/><Setter Property="Stroke" Value="{DynamicResource UiTextSecondary}"/></Style>
<Style Selector="Slider:focus-visible /template/ Thumb#thumb /template/ Border#knob"><Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="Slider.ac-focus /template/ Thumb#thumb /template/ Border#knob"><Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>
<Style Selector="Thumb.ac-range-thumb"><Setter Property="ClipToBounds" Value="False"/><Setter Property="UseLayoutRounding" Value="False"/></Style>
<Style Selector="ac|LoadingSpinner[(ac|ComponentMotion.Reduced)=False]"><Style.Animations><Animation Duration="0:0:0.8" IterationCount="Infinite"><KeyFrame Cue="0%"><Setter Property="Angle" Value="0"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Angle" Value="360"/></KeyFrame></Animation></Style.Animations></Style>
<Style Selector="ac|StageGlyph.ac-active[(ac|ComponentMotion.Reduced)=False]"><Style.Animations><Animation Duration="0:0:0.8" IterationCount="Infinite"><KeyFrame Cue="0%"><Setter Property="Angle" Value="0"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Angle" Value="360"/></KeyFrame></Animation></Style.Animations></Style>
<Style Selector="ac|StatusGlyph.ac-running[(ac|ComponentMotion.Reduced)=False]"><Style.Animations><Animation Duration="0:0:0.8" IterationCount="Infinite"><KeyFrame Cue="0%"><Setter Property="Angle" Value="0"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Angle" Value="360"/></KeyFrame></Animation></Style.Animations></Style>
<Style Selector="ScrollBar.ac-hidden"><Setter Property="Opacity" Value="0"/></Style>
<Style Selector="ScrollBar[(ac|ScrollVisibility.IsEnabled)=True]"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2"/></Transitions></Setter></Style>
<Style Selector="Border.ac-card, Border.ac-group, Border.ac-notice, Border.ac-sheet, Border.ac-popover, Border.ac-tooltip, Border.ac-list-row, Border.ac-split, Border.ac-status, Border.ac-badge"><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="ClipToBounds" Value="False"/><Setter Property="ac:SurfaceContentClip.IsEnabled" Value="True"/></Style>
<Style Selector="ContentControl.ac-popover"><Setter Property="Theme" Value="{DynamicResource AcPopover}"/></Style>
<Style Selector=":is(Control).ac"><Setter Property="ToolTip.ShowDelay" Value="600"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ToggleButton.ac"><Setter Property="Theme" Value="{DynamicResource AcToggleButton}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) Expander.ac"><Setter Property="Theme" Value="{DynamicResource AcExpander}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TreeView.ac"><Setter Property="Theme" Value="{DynamicResource AcTreeView}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TabControl.ac"><Setter Property="Theme" Value="{DynamicResource AcTabControl}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented)"><Setter Property="Theme" Value="{DynamicResource AcListBox}"/><Setter Property="Background" Value="{DynamicResource UiTransparent}"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBoxItem.ac"><Setter Property="Theme" Value="{DynamicResource AcListBoxItem}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TreeViewItem.ac"><Setter Property="Theme" Value="{DynamicResource AcTreeViewItem}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TabItem.ac"><Setter Property="Theme" Value="{DynamicResource AcTabItem}"/></Style>
<Style Selector="ListBox.ac:not(.ac-segmented) ListBoxItem:selected TextBlock.caption"><Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/></Style>
<Style Selector="ListBox.ac:not(.ac-segmented) ListBoxItem"><Setter Property="MinHeight" Value="{DynamicResource AcTextRowHeight}"/></Style>
<Style Selector="ListBox.ac.media ListBoxItem"><Setter Property="MinHeight" Value="{DynamicResource AcListHeight}"/></Style>
<Style Selector="ListBox.ac.surface ListBoxItem"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
<Style Selector="ListBox.ac:focus-within ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented) ListBoxItem"><Setter Property="Theme" Value="{DynamicResource AcListBoxItem}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TreeView.ac TreeViewItem"><Setter Property="Theme" Value="{DynamicResource AcTreeViewItem}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) TabControl.ac TabItem"><Setter Property="Theme" Value="{DynamicResource AcTabItem}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented) ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiTransparent}"/><Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented) ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource AcSelection}"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/></Style>
<Style Selector="Window:not(.mac-os9):not(.windows-xp) ListBox.ac:not(.ac-segmented):focus-within ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiAccentText}"/></Style>
</Styles>
