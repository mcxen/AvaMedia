  <Thickness x:Key="AcOutlineThickness">1</Thickness>
  <FontFamily x:Key="UiNumericFont">SF Mono, Menlo, DejaVu Sans Mono</FontFamily>
  <ResourceDictionary.ThemeDictionaries>
