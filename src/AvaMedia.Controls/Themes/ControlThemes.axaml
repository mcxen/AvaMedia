    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource UiTransparent}"/>
  </ControlTheme>
  <ControlTheme x:Key="AcSliderVerticalTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="{DynamicResource UiTransparent}"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AcProgressRadius}" Width="{DynamicResource AcSliderTrack}" HorizontalAlignment="Center"/></ControlTemplate></Setter></ControlTheme>
<ControlTheme x:Key="AcSlider" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AcSliderHeight}"/>
    <Setter Property="Template"><ControlTemplate><Grid Height="{DynamicResource AcSliderHeight}"><Border Height="{DynamicResource AcSliderTrack}" Background="{DynamicResource UiTrack}" CornerRadius="{DynamicResource AcProgressRadius}" VerticalAlignment="Center"/><Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="{TemplateBinding Orientation}"><Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource AcSliderTrackButton}" Background="{TemplateBinding Foreground}"/></Track.DecreaseButton><Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource AcSliderTrackButton}"/></Track.IncreaseButton><Track.Thumb><Thumb Name="thumb" ClipToBounds="False" UseLayoutRounding="False" Width="{DynamicResource AcSliderThumb}" Height="{DynamicResource AcSliderThumb}"><Thumb.Template><ControlTemplate><Border Name="knob" CornerRadius="{DynamicResource AcStatusRadius}" Background="{DynamicResource AcKnob}" BoxShadow="{DynamicResource AcKnobShadow}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track><TickBar Name="ticks" Height="5" VerticalAlignment="Bottom" Fill="{DynamicResource AcTextTertiary}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" Placement="Bottom" IsVisible="False"/></Grid></ControlTemplate></Setter>
    <Style Selector="^:focus-visible /template/ Border#knob">
    <Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>

    <Style Selector="^.ac-focus /template/ Border#knob">
    <Setter Property="BoxShadow" Value="{DynamicResource AcFocusShadow}"/></Style>

    <Style Selector="^:pressed /template/ Thumb#thumb">
    <Setter Property="RenderTransform" Value="scale(1.08)"/></Style>

    <Style Selector="^.ac-pressed /template/ Thumb#thumb">
    <Setter Property="RenderTransform" Value="scale(1.08)"/></Style>

    <Style Selector="^.ticks /template/ TickBar#ticks">
    <Setter Property="IsVisible" Value="True"/></Style>

    <Style Selector="^.ticks /template/ Thumb#thumb">
    <Setter Property="Width" Value="14"/></Style>

    <Style Selector="^.ticks /template/ Border#knob">
    <Setter Property="CornerRadius" Value="5,5,9,9"/></Style>

    <Style Selector="^:disabled">
    <Setter Property="Opacity" Value="{DynamicResource AcDisabledOpacity}"/></Style>

  <Style Selector="^:vertical"><Setter Property="Template"><ControlTemplate><Grid Width="{DynamicResource AcSliderHeight}"><Border Width="{DynamicResource AcSliderTrack}" Background="{DynamicResource UiTrack}" CornerRadius="{DynamicResource AcProgressRadius}" HorizontalAlignment="Center"/><Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="{TemplateBinding Orientation}"><Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource AcSliderVerticalTrackButton}" Background="{TemplateBinding Foreground}"/></Track.DecreaseButton><Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource AcSliderVerticalTrackButton}"/></Track.IncreaseButton><Track.Thumb><Thumb Name="thumb" ClipToBounds="False" UseLayoutRounding="False" Width="{DynamicResource AcSliderThumb}" Height="{DynamicResource AcSliderThumb}"><Thumb.Template><ControlTemplate><Border Name="knob" CornerRadius="{DynamicResource AcStatusRadius}" Background="{DynamicResource AcKnob}" BoxShadow="{DynamicResource AcKnobShadow}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track><TickBar Name="ticks" Width="5" HorizontalAlignment="Right" Fill="{DynamicResource AcTextTertiary}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" Placement="Right" IsVisible="False"/></Grid></ControlTemplate></Setter></Style></ControlTheme>
  <ControlTheme x:Key="AcProgressBar" TargetType="ProgressBar">
<Setter Property="Background" Value="{DynamicResource UiTrack}"/>
    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AcProgressRadius}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AcNoBorder}"/>
    <Setter Property="Height" Value="{DynamicResource AcProgressHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AcProgressHeight}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="ShowProgressText" Value="False"/>
<Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True"><Panel>
<Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Left" IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}"/>
<Border Name="PART_IndeterminateIndicator" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Left" Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ac:ComponentResources.ProgressChunk}}" IsVisible="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}"/>
</Panel></Border></ControlTemplate></Setter>
<Style Selector="^:indeterminate[(ac|ComponentMotion.Reduced)=False] /template/ Border#PART_IndeterminateIndicator">
    <Style.Animations><Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut"><KeyFrame Cue="0%">
    <Setter Property="TranslateTransform.X" Value="0"/></KeyFrame><KeyFrame Cue="100%">
    <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].Bounds.Width, Converter={x:Static ac:ComponentResources.ProgressEnd}}"/></KeyFrame></Animation></Style.Animations></Style>

<Style Selector="^.paused">
    <Setter Property="Foreground" Value="{DynamicResource UiWarning}"/></Style>

    <Style Selector="^.failed">
    <Setter Property="Foreground" Value="{DynamicResource UiDanger}"/></Style>


  </ControlTheme>
