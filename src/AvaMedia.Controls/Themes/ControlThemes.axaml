    <Setter Property="IsDirectionReversed" Value="False"/></Style>

    <Style Selector="^ /template/ Thumb#thumb">
    <Setter Property="MinWidth" Value="{DynamicResource AcScrollThumb}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AcScrollThumb}"/></Style>

    <Style Selector="^:vertical:pointerover">
    <Setter Property="Width" Value="15"/></Style>

    <Style Selector="^:vertical.ac-hover">
    <Setter Property="Width" Value="15"/></Style>

    <Style Selector="^:pointerover /template/ Border#scrollFace">
    <Setter Property="Background" Value="{DynamicResource AcScrollTrack}"/><Setter Property="BorderBrush" Value="{DynamicResource AcStageLineBrush}"/><Setter Property="BorderThickness" Value="0.5,0,0,0"/></Style>

    <Style Selector="^.ac-hover /template/ Border#scrollFace">
    <Setter Property="Background" Value="{DynamicResource AcScrollTrack}"/><Setter Property="BorderBrush" Value="{DynamicResource AcStageLineBrush}"/><Setter Property="BorderThickness" Value="0.5,0,0,0"/></Style>

    <Style Selector="^:pointerover /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource AcScrollHover}"/></Style>

    <Style Selector="^.ac-hover /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource AcScrollHover}"/></Style>

    <Style Selector="^:pointerover /template/ Border#scrollKnob">
    <Setter Property="Margin" Value="2,0"/></Style>

    <Style Selector="^.ac-hover /template/ Border#scrollKnob">
    <Setter Property="Margin" Value="2,0"/></Style>

  <Style Selector="^:horizontal:pointerover"><Setter Property="Height" Value="15"/></Style><Style Selector="^:horizontal.ac-hover"><Setter Property="Height" Value="15"/></Style>
  <Style Selector="^:horizontal:pointerover /template/ Border#scrollKnob"><Setter Property="Margin" Value="0,2"/></Style><Style Selector="^:horizontal.ac-hover /template/ Border#scrollKnob"><Setter Property="Margin" Value="0,2"/></Style>
  <Style Selector="^:horizontal:pointerover /template/ Border#scrollFace"><Setter Property="BorderThickness" Value="0,0.5,0,0"/></Style><Style Selector="^:horizontal.ac-hover /template/ Border#scrollFace"><Setter Property="BorderThickness" Value="0,0.5,0,0"/></Style></ControlTheme>
