    <Setter Property="FontFamily" Value="{DynamicResource UiNumericFont}"/>
    <Setter Property="MinWidth" Value="{DynamicResource AcNumericMinWidth}"/>
    <Setter Property="Height" Value="{DynamicResource AcFieldHeight}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><ControlTemplate><ButtonSpinner Name="PART_Spinner" Theme="{StaticResource AcButtonSpinner}" AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="4"><TextBox Name="PART_TextBox" Theme="{StaticResource AcTextBox}" Text="{TemplateBinding Text}" TextAlignment="{TemplateBinding TextAlignment}" IsReadOnly="{TemplateBinding IsReadOnly}" Watermark="{TemplateBinding Watermark}" InnerLeftContent="{TemplateBinding InnerLeftContent}"/><ContentPresenter Grid.Column="1" Content="{TemplateBinding InnerRightContent}" VerticalAlignment="Center"/></Grid></ButtonSpinner></ControlTemplate></Setter>






