  </ControlTheme>
  <ControlTheme x:Key="AcNumericUpDown" TargetType="NumericUpDown">
    <Style Selector="^.compact"><Setter Property="MinWidth" Value="{DynamicResource AcNumericCompactMinWidth}"/></Style>
