<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>LibArchive.Net</id>
    <version>0.3.1</version>
    <title>LibArchive.Net</title>
    <authors>James A Sutherland</authors>
    <license type="expression">BSD-2-Clause</license>
    <licenseUrl>https://licenses.nuget.org/BSD-2-Clause</licenseUrl>
    <projectUrl>https://github.com/jas88/libarchive.net/</projectUrl>
    <description>This package provides access to the native libarchive compression library (included) on Linux (x64, musl-x64), Windows (x86, x64, arm64), and macOS (x64, arm64) platforms. Supports Native AOT and trimming for .NET 6+.</description>
    <copyright>Copyright 2022-2024</copyright>
    <tags>Compression Libarchive Tar Zip 7Zip Rar AOT NativeAOT Trimming</tags>
    <repository type="git" url="https://github.com/jas88/libarchive.net.git" commit="31e5dd26941e1d65a35818562c23ee42064498d0" />
    <dependencies>
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework="net10.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Buffers" version="4.6.1" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>